<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_bg" />
        </shape>
    </item>
    <!-- Soft cyan wash from top -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="280dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/profile_accent_soft"
                android:type="linear" />
        </shape>
    </item>
    <!-- Diagonal ink depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:centerColor="#0A1220"
                android:endColor="@color/profile_bg"
                android:startColor="#0F2A3F"
                android:type="linear" />
        </shape>
    </item>
    <!-- Bottom vignette -->
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="160dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#CC070709"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
