<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/profile_bg" /></shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="320dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:type="linear"
                android:startColor="#40D08A4A" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="145" android:type="linear"
                android:startColor="#1A140C" android:centerColor="#0C0A08" android:endColor="#0C0A08" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:type="linear"
                android:startColor="#E60C0A08" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
