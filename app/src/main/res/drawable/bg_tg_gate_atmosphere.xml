<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/support_bg" />
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/support_accent_soft"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="150"
                android:centerColor="#100808"
                android:endColor="@color/support_bg"
                android:startColor="#1A0608"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="200dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#E00A0A0A"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
