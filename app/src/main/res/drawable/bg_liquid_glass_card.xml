<?xml version="1.0" encoding="utf-8"?>
<!-- Solids only: linear gradients inside layer-list crashed draw on some
     Atouch/Android-10 OEMs (BETTERSTREAMFLIX-3J — angle % 45 check). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer bloom -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Frosted panel -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC222226" />
            <corners android:radius="21dp" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
    <!-- Specular top edge (flat highlight — no linear gradient) -->
    <item
        android:bottom="18dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="19dp"
                android:topRightRadius="19dp" />
        </shape>
    </item>
</layer-list>
