<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass" />
            <stroke
                android:width="2dp"
                android:color="@color/cinema_text_muted" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass" />
            <stroke
                android:width="1dp"
                android:dashWidth="4dp"
                android:dashGap="3dp"
                android:color="@color/cinema_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
