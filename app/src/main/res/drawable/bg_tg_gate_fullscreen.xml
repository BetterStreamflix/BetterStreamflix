<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base ink -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tg_gate_bg_deep" />
        </shape>
    </item>
    <!-- Diagonal cinema depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="155"
                android:centerColor="@color/tg_gate_bg_mid"
                android:endColor="@color/tg_gate_bg_deep"
                android:startColor="@color/tg_gate_bg_glow"
                android:type="linear" />
        </shape>
    </item>
    <!-- Primary signal bloom (upper center, behind hero) -->
    <item
        android:gravity="top|center_horizontal"
        android:height="460dp"
        android:width="460dp"
        android:top="-96dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="230dp"
                android:startColor="@color/tg_gate_telegram_soft"
                android:type="radial" />
        </shape>
    </item>
    <!-- Secondary cyan bloom (upper-end, slightly offset) -->
    <item
        android:gravity="top|end"
        android:height="280dp"
        android:width="280dp"
        android:top="40dp"
        android:right="-60dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="140dp"
                android:startColor="@color/tg_gate_orb"
                android:type="radial" />
        </shape>
    </item>
    <!-- Cool ink bloom (lower-start) for depth balance -->
    <item
        android:gravity="bottom|start"
        android:height="320dp"
        android:width="320dp"
        android:bottom="80dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="160dp"
                android:startColor="@color/tg_gate_bg_bloom"
                android:type="radial" />
        </shape>
    </item>
    <!-- Soft teal wash top -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/tg_gate_telegram_mist"
                android:type="linear" />
        </shape>
    </item>
    <!-- Edge vignette left -->
    <item
        android:gravity="start|fill_vertical"
        android:width="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#00000000"
                android:startColor="@color/tg_gate_scrim"
                android:type="linear" />
        </shape>
    </item>
    <!-- Edge vignette right -->
    <item
        android:gravity="end|fill_vertical"
        android:width="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:endColor="#00000000"
                android:startColor="@color/tg_gate_scrim"
                android:type="linear" />
        </shape>
    </item>
    <!-- Bottom vignette for CTA stage -->
    <item
        android:gravity="bottom|fill_horizontal"
        android:height="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="@color/tg_gate_scrim"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
