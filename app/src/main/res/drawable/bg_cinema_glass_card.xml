<?xml version="1.0" encoding="utf-8"?>
<!-- Cinema Ink glass card — season tiles and similar Leanback plates. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass" />
            <corners android:radius="@dimen/cinema_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/cinema_stroke" />
            <corners android:radius="@dimen/cinema_radius_md" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
