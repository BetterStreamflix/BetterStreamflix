<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass" />
            <corners android:radius="14dp" />
            <stroke
                android:width="?attr/tvFocusStrokeWidth"
                android:color="?attr/tvFocusStrokeColor" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_row_wash" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/cinema_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_row_wash" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/cinema_text_muted" />
        </shape>
    </item>
</selector>
