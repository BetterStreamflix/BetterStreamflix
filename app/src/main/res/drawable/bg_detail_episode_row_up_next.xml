<?xml version="1.0" encoding="utf-8"?>
<!-- Soft resume accent — no blue border, just a brighter glass plate. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_row_wash" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/cinema_glass_bright" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
