<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#080605" /></shape></item>
    <item android:gravity="top|fill_horizontal" android:height="280dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#55A03A28" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="200dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#F2080605" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
