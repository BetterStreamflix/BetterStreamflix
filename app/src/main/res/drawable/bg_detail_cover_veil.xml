<?xml version="1.0" encoding="utf-8"?>
<!-- Clear sky → mid haze → solid page gray at the tabs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep top of the art readable -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#22000000"
                android:endColor="#66000000"
                android:startColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Progressive gray wash into the page -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#99181818"
                android:endColor="#10181818"
                android:startColor="#FF181818"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
