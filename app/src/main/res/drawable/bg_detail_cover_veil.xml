<?xml version="1.0" encoding="utf-8"?>
<!-- Soft gray haze into the page tone — avoid hard black bands at the tabs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep top of the art readable -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#18000000"
                android:endColor="#4D000000"
                android:startColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- Progressive gray wash into the page -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#B3181818"
                android:endColor="#20181818"
                android:startColor="#FF181818"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
