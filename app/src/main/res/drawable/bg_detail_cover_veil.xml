<?xml version="1.0" encoding="utf-8"?>
<!--
  Progressive cover veil: artwork stays readable up top, then washes into
  page gray so the hero can run all the way down to the detail tabs.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#66181818"
                android:endColor="#00000000"
                android:startColor="#00181818"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#CC2A2A2E"
                android:endColor="#002A2A2E"
                android:startColor="#FF181818"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
