<?xml version="1.0" encoding="utf-8"?>
<!-- Atmospheric hero wash — raised alpha so muted meta text stays legible on
     bright backdrops, while the art still reads through (never a solid slab). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#42121218"
        android:endColor="#00000000"
        android:startColor="#8A121218"
        android:type="linear" />
</shape>
