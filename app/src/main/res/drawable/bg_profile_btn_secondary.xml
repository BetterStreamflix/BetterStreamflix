<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_surface_soft" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/profile_text_tertiary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_surface" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="@color/profile_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_surface" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/profile_border" />
        </shape>
    </item>
</selector>
