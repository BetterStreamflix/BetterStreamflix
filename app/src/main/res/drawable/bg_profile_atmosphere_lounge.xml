<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#0C0A10" /></shape></item>
    <item android:gravity="top|fill_horizontal" android:height="300dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#559B7EC8" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E60C0A10" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
