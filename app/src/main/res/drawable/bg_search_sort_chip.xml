<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass_strong" />
            <stroke
                android:width="2dp"
                android:color="@color/cinema_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cinema_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/cinema_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
