<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Downloads are large and re-fetchable; user state syncs via the in-app backup. -->
        <exclude domain="file" path="downloads/" />
        <!-- Secrets & auth must never leave the device via cloud backup (H-SEC-3). -->
        <exclude domain="sharedpref" path="supabase_connection.xml" />
        <exclude domain="sharedpref" path="beta_profiles.xml" />
        <exclude domain="sharedpref" path="cloud_account_state.xml" />
        <exclude domain="sharedpref" path="cloud_sync_queue.xml" />
        <exclude domain="sharedpref" path="cloud_notes_looks_queue.xml" />
        <exclude domain="sharedpref" path="trakt_oauth.xml" />
        <exclude domain="sharedpref" path="download_headers.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.debug.preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app_preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.debug_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
        <exclude domain="sharedpref" path="supabase_connection.xml" />
        <exclude domain="sharedpref" path="beta_profiles.xml" />
        <exclude domain="sharedpref" path="cloud_account_state.xml" />
        <exclude domain="sharedpref" path="cloud_sync_queue.xml" />
        <exclude domain="sharedpref" path="cloud_notes_looks_queue.xml" />
        <exclude domain="sharedpref" path="trakt_oauth.xml" />
        <exclude domain="sharedpref" path="download_headers.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.debug.preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app_preferences.xml" />
        <exclude domain="sharedpref" path="com.betterstreamflix.app.debug_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
