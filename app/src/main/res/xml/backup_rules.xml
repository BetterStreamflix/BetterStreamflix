<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Large / re-fetchable -->
    <exclude domain="file" path="downloads/" />
    <!-- Secrets & auth (H-SEC-3) -->
    <exclude domain="sharedpref" path="supabase_connection.xml" />
    <exclude domain="sharedpref" path="beta_profiles.xml" />
    <exclude domain="sharedpref" path="cloud_account_state.xml" />
    <exclude domain="sharedpref" path="cloud_sync_queue.xml" />
    <exclude domain="sharedpref" path="trakt_oauth.xml" />
    <exclude domain="sharedpref" path="download_headers.xml" />
    <!-- Tokens, cookies, parental PIN live in the main prefs file -->
    <exclude domain="sharedpref" path="com.dskja.betterstreamflix.preferences.xml" />
    <exclude domain="sharedpref" path="com.dskja.betterstreamflix.debug.preferences.xml" />
</full-backup-content>
