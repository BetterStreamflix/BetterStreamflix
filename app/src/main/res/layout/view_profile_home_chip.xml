<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_home_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:minWidth="48dp"
    android:background="@drawable/bg_profile_home_chip"
    android:clickable="true"
    android:contentDescription="@string/profile_switch_title"
    android:elevation="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <com.betterstreamflix.app.profiles.ProfileAvatarView
        android:id="@+id/pav_home_profile"
        android:layout_width="32dp"
        android:layout_height="32dp" />

    <!-- Shown when HomeProfileChip.refresh(showName=true); otherwise GONE. -->
    <TextView
        android:id="@+id/tv_home_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxWidth="120dp"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Alex"
        tools:visibility="visible" />
</LinearLayout>
