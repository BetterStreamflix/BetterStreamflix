<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_home_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:background="@drawable/bg_profile_home_chip"
    android:clickable="true"
    android:contentDescription="@string/profile_switch_title"
    android:elevation="2dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="12dp">

    <com.dskja.betterstreamflix.profiles.ProfileAvatarView
        android:id="@+id/pav_home_profile"
        android:layout_width="28dp"
        android:layout_height="28dp" />

    <TextView
        android:id="@+id/tv_home_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="92dp"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        tools:text="Alex" />
</LinearLayout>
