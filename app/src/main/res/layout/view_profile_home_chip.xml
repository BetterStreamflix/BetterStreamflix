<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_home_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:background="@drawable/bg_profile_home_chip"
    android:clickable="true"
    android:contentDescription="@string/profile_switch_title"
    android:elevation="12dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal">

    <com.dskja.betterstreamflix.profiles.ProfileAvatarView
        android:id="@+id/pav_home_profile"
        android:layout_width="32dp"
        android:layout_height="32dp" />

    <!-- Kept for binding compatibility; the chip shows the avatar only. -->
    <TextView
        android:id="@+id/tv_home_profile_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:text="Alex" />
</LinearLayout>
