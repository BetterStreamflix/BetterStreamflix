<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_detail_trailer_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="152dp"
        android:layout_height="86dp">

        <ImageView
            android:id="@+id/iv_detail_trailer_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF141418"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#40000000" />

        <ImageView
            android:id="@+id/iv_detail_trailer_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_trailer_play_overlay"
            android:contentDescription="@string/movie_trailer"
            android:padding="11dp"
            android:src="@drawable/ic_trailer_play"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_detail_trailer_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_detail_trailer_official_badge"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.04"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/detail_trailer_official_badge"
            android:textAllCaps="true"
            android:textColor="#FF121218"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_detail_trailer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Official Trailer" />

        <TextView
            android:id="@+id/tv_detail_trailer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Trailer" />

        <TextView
            android:id="@+id/tv_detail_trailer_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="2"
            android:textColor="#8AFFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Official Trailer" />
    </LinearLayout>
</LinearLayout>
