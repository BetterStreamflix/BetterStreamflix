<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/cinema_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/chip_series_fast_forward"
        app:layout_constraintEnd_toStartOf="@id/chip_series_fast_forward"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/chip_series_fast_forward"
        tools:text="Next Episodes" />

    <TextView
        android:id="@+id/chip_series_fast_forward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_series_fast_forward_chip"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/hgv_category"
        android:nextFocusLeft="@id/nav_main"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/home_series_fast_forward_chip"
        android:textColor="@color/cinema_text_soft"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/tv_shelf_weather"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/tv_category_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="70dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_shelf_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="70dp"
        android:background="@drawable/bg_shelf_weather_pill"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="@color/cinema_destructive"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/chip_series_fast_forward"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/chip_series_fast_forward"
        app:layout_constraintTop_toTopOf="@id/chip_series_fast_forward"
        tools:text="unstable"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_category_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cinema_accent_rule"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_category_title"
        app:layout_constraintTop_toBottomOf="@id/chip_series_fast_forward"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_series_fast_forward_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="70dp"
        android:text="@string/home_series_fast_forward_empty"
        android:textColor="@color/cinema_text_soft"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_category_rule"
        tools:visibility="visible" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hgv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusLeft="@id/nav_main"
        android:nextFocusUp="@id/chip_series_fast_forward"
        android:paddingStart="70dp"
        android:paddingEnd="70dp"
        android:paddingBottom="10dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:focusOutSideEnd="true"
        app:focusOutSideStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_series_fast_forward_empty" />

    <View
        android:id="@+id/v_category_edge_fade_start"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_start"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hgv_category"
        app:layout_constraintStart_toStartOf="@id/hgv_category"
        app:layout_constraintTop_toTopOf="@id/hgv_category"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_category_edge_fade_end"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_end"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hgv_category"
        app:layout_constraintEnd_toEndOf="@id/hgv_category"
        app:layout_constraintTop_toTopOf="@id/hgv_category"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
