<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/support_hero_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_support_hero_cinematic"
    android:minHeight="@dimen/support_hero_min_height"
    android:orientation="vertical"
    android:padding="@dimen/support_page_padding"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/iv_support_hero_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/support_hub_title"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tv_support_hero_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:letterSpacing="-0.02"
        android:text="@string/support_hero_title"
        android:textAppearance="@style/TextAppearance.Lumina.Brand"
        android:textColor="@color/support_text_primary"
        android:textSize="@dimen/support_text_hero"
        android:textStyle="bold" />

    <View
        android:id="@+id/v_support_hero_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_accent_rule" />

    <TextView
        android:id="@+id/tv_support_hero_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/support_hero_body"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:textColor="@color/support_text_secondary"
        android:textSize="@dimen/support_text_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_support_hero_primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/support_button_height"
            android:layout_weight="1"
            android:background="@drawable/bg_exp_button_liquid_primary"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/support_hero_cta_primary"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="@color/support_on_accent"
            android:textSize="@dimen/support_text_cta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_support_hero_secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/support_button_height"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_exp_button_liquid_secondary"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/support_hero_cta_secondary"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="@color/support_text_primary"
            android:textSize="@dimen/support_text_cta" />
    </LinearLayout>
</LinearLayout>
