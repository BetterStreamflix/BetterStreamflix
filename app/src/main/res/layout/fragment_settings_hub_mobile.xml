<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_settings_hub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="72dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tv_settings_hub_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_hub_eyebrow"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_settings_hub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_hub_title"
                android:textAppearance="@style/TextAppearance.Lumina.Hero"
                android:textColor="?attr/colorOnSurface"
                android:textSize="32sp" />

            <View
                android:id="@+id/v_settings_hub_accent_rule"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_exp_accent_rule" />

            <TextView
                android:id="@+id/tv_settings_hub_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_hub_subtitle"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Featured integrations -->
            <LinearLayout
                android:id="@+id/card_settings_featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_exp_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_exp_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/settings_hub_featured_badge"
                    android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/platform_settings_title"
                    android:textAppearance="@style/TextAppearance.Lumina.Title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/platform_settings_summary"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_exp_button_primary"
                    android:focusable="false"
                    android:gravity="center"
                    android:text="@string/settings_hub_featured_cta"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:letterSpacing="0.04"
                android:text="@string/settings_hub_section_app"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_settings_hub_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:letterSpacing="0.04"
                android:text="@string/settings_hub_section_account"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_settings_hub_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:letterSpacing="0.04"
                android:text="@string/settings_hub_section_project"
                android:textAllCaps="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_settings_hub_project"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
