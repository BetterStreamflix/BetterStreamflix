<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_exp_dialog"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tv_crash_log_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_view_crash_log_title"
        android:textAppearance="@style/TextAppearance.Lumina.Title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp" />

    <View
        android:id="@+id/v_crash_log_rule"
        android:layout_width="36dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_exp_accent_rule" />

    <ScrollView
        android:id="@+id/sv_crash_log_body"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_provider_card"
        android:fillViewport="true"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_crash_log_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_log_clear"
            style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/crash_log_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_log_share"
            style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/crash_log_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_log_copy"
            style="@style/AppTheme.Widget.Mobile.Button.Exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/crash_log_copy" />
    </LinearLayout>
</LinearLayout>
