<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinema_ink"
    android:padding="20dp"
    tools:context=".remotefind.RemoteFindPhoneActivity">

    <TextView
        android:id="@+id/tv_remote_find_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/remote_find_phone_title"
        android:textColor="@color/cinema_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_remote_find_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/remote_find_phone_connecting"
        android:textColor="@color/cinema_text_muted"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_remote_find_title" />

    <EditText
        android:id="@+id/et_remote_find_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_search_edittext"
        android:hint="@string/remote_find_keyboard_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/cinema_text"
        android:textColorHint="@color/cinema_text_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_remote_find_status"
        tools:ignore="Autofill,LabelFor" />

    <LinearLayout
        android:id="@+id/ll_remote_find_keys"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_remote_find_query">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_find_clear"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remote_find_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_find_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remote_find_search" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_remote_find_pad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_tv_focus_ring"
        android:contentDescription="@string/remote_find_touchpad_cd"
        app:layout_constraintBottom_toTopOf="@id/ll_remote_find_pad_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_remote_find_keys">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/remote_find_touchpad_hint"
            android:textColor="@color/cinema_text_muted"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_remote_find_pad_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_find_back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/remote_find_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remote_find_select"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/remote_find_select" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
