<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:maxHeight="520dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/profile_settings_hero_eyebrow"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:textColor="@color/profile_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_create_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/syne"
                android:text="@string/profile_create_title"
                android:textAppearance="@style/TextAppearance.Lumina.Title"
                android:textColor="@color/profile_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_create_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/profile_create_subtitle"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="@color/profile_text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/v_profile_create_rule"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_exp_accent_rule" />

            <com.dskja.betterstreamflix.profiles.ProfileAvatarView
                android:id="@+id/pav_profile_create_preview"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tv_profile_create_avatar_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Crimson" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/profile_name_hint"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_profile_create_name"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_field"
                android:hint="@string/profile_name_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="@color/profile_text_primary"
                android:textColorHint="@color/profile_text_tertiary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_avatar_choose"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_profile_create_avatars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/profile_pin_title"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_profile_create_pin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_field"
                android:hint="@string/profile_pin_optional_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="8"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="@color/profile_text_primary"
                android:textColorHint="@color/profile_text_tertiary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_profile_clear_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_pin_clear_title"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_text_secondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <CheckBox
                android:id="@+id/cb_profile_create_kids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_kids_title"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_profile_create_advanced"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="2dp"
                    android:paddingEnd="8dp"
                    android:text="@string/profile_advanced"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/profile_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_profile_create_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/profile_integration_summary"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/profile_text_tertiary"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cb_profile_int_trakt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_trakt"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_jellyfin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_jellyfin"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_plex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_plex"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_debrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_debrid"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_simkl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_simkl"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_opensubtitles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_opensubtitles"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />

                <CheckBox
                    android:id="@+id/cb_profile_int_tmdb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/profile_integration_tmdb"
                    android:textAppearance="@style/TextAppearance.Lumina.Body"
                    android:textColor="@color/profile_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_profile_create_delete"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/profile_delete_title"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/profile_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_profile_create_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@android:string/cancel"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="@color/profile_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_profile_create_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_profile_btn_primary"
            android:gravity="center"
            android:minWidth="128dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/profile_save"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="@color/profile_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
