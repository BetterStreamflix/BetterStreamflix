<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="20dp">

    <!-- Soft blurred portrait as atmosphere — not a random film backdrop. -->
    <ImageView
        android:id="@+id/iv_people_backdrop"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:alpha="0.45"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/v_people_backdrop_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_people_header_scrim"
        app:layout_constraintBottom_toBottomOf="@id/iv_people_backdrop"
        app:layout_constraintEnd_toEndOf="@id/iv_people_backdrop"
        app:layout_constraintStart_toStartOf="@id/iv_people_backdrop"
        app:layout_constraintTop_toTopOf="@id/iv_people_backdrop" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_people_image"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_marginTop="64dp"
        android:background="#1AFFFFFF"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumina.Poster"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_person_placeholder" />

    <TextView
        android:id="@+id/tv_people_department"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_people_department_chip"
        android:fontFamily="@font/manrope"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_people_image"
        tools:text="Acting"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_people_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_department"
        tools:text="Tom Holland" />

    <View
        android:id="@+id/v_people_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_name" />

    <!-- Single centered meta line: Born 1 Jun 1996 · Kingston upon Thames -->
    <TextView
        android:id="@+id/tv_people_birthday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_people_rule"
        tools:text="Born 1 Jun 1996 · Kingston upon Thames" />

    <!-- Hidden: meta is merged into birthday line. -->
    <TextView
        android:id="@+id/tv_people_meta_dot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_people_birthplace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_birthday"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_birthplace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_people_birthplace" />

    <TextView
        android:id="@+id/tv_people_deathday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_birthday"
        tools:text="Died 2 Jun 2004" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_deathday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_deathday"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_people_biography_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/manrope"
        android:text="@string/people_biography"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_deathday" />

    <TextView
        android:id="@+id/tv_people_biography"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_biography_label"
        tools:text="Biography" />

    <TextView
        android:id="@+id/tv_people_biography_read_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_button_read_more"
        android:fontFamily="@font/manrope"
        android:text="@string/people_read_more"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_biography"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_biography"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_biography_label,tv_people_biography,tv_people_biography_read_more"
        tools:visibility="visible" />

    <TextView
        android:id="@id/tv_people_filmography_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/manrope"
        android:text="@string/people_known_for"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_biography_read_more" />

    <View
        android:id="@id/v_people_filmography_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:background="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_filmography_label" />

</androidx.constraintlayout.widget.ConstraintLayout>
