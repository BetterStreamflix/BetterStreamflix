<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_rail_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_exp_provider_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/iv_settings_rail_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_settings_help"
        android:tint="?attr/colorPrimary"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tv_settings_rail_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.CinemaInk.Caption"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp"
        tools:text="Playback" />

    <View
        android:id="@+id/v_settings_rail_indicator"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_cinema_accent_rule"
        android:visibility="invisible" />
</LinearLayout>
