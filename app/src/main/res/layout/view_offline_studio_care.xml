<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sv_offline_studio_care"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp"
    android:scrollbars="none"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/ll_offline_studio_care"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tv_offline_studio_care_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp"
            android:text="@string/offline_studio_care_intro"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/card_offline_studio_lane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_offline_studio_lane_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_lane_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_studio_lane_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="Watching 1 · Queue 2 · Smart 1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_offline_studio_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_offline_studio_health_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_health_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_studio_health_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:textColor="#FFFF8A80"
                android:textSize="13sp"
                tools:text="3 downloads unplayable" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_offline_studio_health_redownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/downloads_health_redownload_all_a11y"
                android:minHeight="44dp"
                android:text="@string/downloads_health_redownload_all"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_offline_studio_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_offline_studio_expiry_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_expiry_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_studio_expiry_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="Show A\nShow B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_offline_studio_expiry_keep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minHeight="44dp"
                    android:text="@string/offline_studio_expiry_keep"
                    android:textAllCaps="false" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_offline_studio_expiry_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/offline_studio_expiry_delete"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_offline_studio_care_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:padding="28dp"
            android:text="@string/offline_studio_care_empty"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
