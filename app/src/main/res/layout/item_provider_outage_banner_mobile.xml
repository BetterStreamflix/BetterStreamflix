<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/provider_outage_banner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/support_mobile_margin"
    android:layout_marginEnd="@dimen/support_mobile_margin"
    android:background="@drawable/bg_support_banner"
    android:focusable="true"
    android:minHeight="@dimen/support_banner_height"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_provider_outage_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_providers_language"
            android:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_provider_outage_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/support_text_primary"
                android:textSize="@dimen/support_text_card_title"
                android:textStyle="bold"
                tools:text="Provider outage" />

            <TextView
                android:id="@+id/tv_provider_outage_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:textColor="@color/support_text_secondary"
                android:textSize="@dimen/support_text_caption"
                tools:text="SFlix looks down — open Trust Layer" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_provider_outage_cta"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_support_btn_primary"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/provider_outage_banner_cta"
            android:textColor="@color/support_on_accent"
            android:textSize="@dimen/support_text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_provider_outage_dismiss"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/provider_outage_banner_dismiss_cd"
        android:padding="6dp"
        android:src="@drawable/ic_support_close"
        android:tint="@color/support_text_tertiary"
        tools:ignore="UseAppTint" />
</FrameLayout>
