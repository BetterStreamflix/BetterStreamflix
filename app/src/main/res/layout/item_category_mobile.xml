<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.01"
        android:maxLines="1"
        android:shadowColor="#73000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/cinema_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_shelf_pin"
        app:layout_constraintEnd_toStartOf="@id/tv_shelf_weather"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_shelf_pin"
        app:layout_goneMarginEnd="8dp"
        tools:text="Next Episodes" />

    <TextView
        android:id="@+id/tv_shelf_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_shelf_weather_pill"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/cinema_destructive"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_shelf_pin"
        app:layout_constraintEnd_toStartOf="@id/chip_series_fast_forward"
        app:layout_constraintTop_toTopOf="@id/btn_shelf_pin"
        app:layout_goneMarginEnd="8dp"
        tools:text="unstable"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/chip_series_fast_forward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_series_fast_forward_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/home_series_fast_forward_chip"
        android:textColor="@color/cinema_text_soft"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btn_shelf_pin"
        app:layout_constraintEnd_toStartOf="@id/btn_shelf_pin"
        app:layout_constraintTop_toTopOf="@id/btn_shelf_pin"
        app:layout_goneMarginEnd="6dp"
        tools:visibility="visible" />

    <ImageButton
        android:id="@+id/btn_shelf_pin"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/home_shelf_pin_cd"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_shelf_pin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/cinema_text_muted" />

    <TextView
        android:id="@+id/tv_series_fast_forward_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:text="@string/home_series_fast_forward_empty"
        android:textColor="@color/cinema_text_soft"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_shelf_pin"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_series_fast_forward_empty"
        tools:listitem="@layout/item_movie_mobile" />

</androidx.constraintlayout.widget.ConstraintLayout>
