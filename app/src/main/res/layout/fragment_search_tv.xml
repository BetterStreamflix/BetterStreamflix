<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.search.SearchTvFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="100dp"
        android:background="@drawable/bg_search_edittext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.leanback.widget.SearchEditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="#FFFFFF"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusRight="@+id/btn_search_clear"
            android:nextFocusDown="@id/ll_global_search"
            android:padding="14dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@+id/btn_search_voice"
            android:padding="10dp"
            android:src="@drawable/ic_search_clear"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_voice"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_search_recent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/cl_search"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_search_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:id="@+id/v_search_recent_edge_fade_start"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_start"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hsv_search_recent"
        app:layout_constraintStart_toStartOf="@id/hsv_search_recent"
        app:layout_constraintTop_toTopOf="@id/hsv_search_recent" />

    <View
        android:id="@+id/v_search_recent_edge_fade_end"
        android:layout_width="36dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_end"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hsv_search_recent"
        app:layout_constraintEnd_toEndOf="@id/hsv_search_recent"
        app:layout_constraintTop_toTopOf="@id/hsv_search_recent" />

    <LinearLayout
        android:id="@+id/ll_global_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:nextFocusDown="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/hsv_search_recent">

        <TextView
            android:id="@+id/tv_global_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/global_search"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/iv_global_search_switch"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_switch_off"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_global_search"
        tools:listitem="@layout/item_movie_tv" />

    <TextView
        android:id="@+id/tv_search_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/search_no_results"
        android:textColor="@android:color/darker_gray"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_search_empty_rule"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="520dp"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_search_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_search_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_search_empty"
        app:layout_constraintStart_toStartOf="@id/tv_search_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_search_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_search_empty_cta"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="@string/exp_empty_clear_search"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/tv_search_empty"
        app:layout_constraintStart_toStartOf="@id/tv_search_empty"
        app:layout_constraintTop_toBottomOf="@id/v_search_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/vgv_search"
        app:layout_constraintEnd_toEndOf="@id/vgv_search"
        app:layout_constraintStart_toStartOf="@id/vgv_search"
        app:layout_constraintTop_toTopOf="@id/vgv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>