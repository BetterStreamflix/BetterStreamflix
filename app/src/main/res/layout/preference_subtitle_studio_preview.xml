<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/ll_subtitle_studio_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cinema_ink"
        android:gravity="center"
        android:minHeight="96dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tv_subtitle_studio_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/subtitle_studio_preview_sample"
            android:textColor="@color/cinema_text"
            android:textSize="18sp"
            tools:text="Subtitle Studio — sample line" />
    </LinearLayout>

</FrameLayout>
