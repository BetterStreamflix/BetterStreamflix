<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_picker_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_lounge_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <com.dskja.betterstreamflix.profiles.ProfileAvatarView
            android:id="@+id/pav_profile_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp" />

        <View
            android:id="@+id/v_profile_active_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_avatar_ring"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_profile_lock"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_profile_badge"
            android:gravity="center"
            android:text="@string/profile_picker_lock_glyph"
            android:textAppearance="@style/TextAppearance.Nocturne.Caption"
            android:textColor="@color/profile_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Nocturne.Title"
            android:textColor="@color/profile_text_primary"
            android:textSize="17sp"
            tools:text="Alex" />

        <TextView
            android:id="@+id/tv_profile_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Nocturne.Caption"
            android:textColor="@color/profile_text_tertiary"
            android:textSize="12sp"
            tools:text="Active · Copper · 3 continuing" />

        <TextView
            android:id="@+id/tv_profile_kids_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/profile_kids_badge_short"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Nocturne.Eyebrow"
            android:textColor="@color/profile_accent"
            android:textSize="9sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
