<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trailer_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_exp_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_trailer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Lumina.Title"
            android:text="@string/movie_trailer"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_trailer_youtube"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_exp_icon_chip"
            android:contentDescription="@string/youtube"
            android:padding="8dp"
            android:src="@drawable/ic_exp_play"
            android:tint="?attr/colorPrimary"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btn_trailer_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_exp_icon_chip"
            android:contentDescription="@string/exp_cd_close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="?attr/colorOnSurfaceVariant"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <View
        android:id="@+id/v_trailer_accent_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_exp_accent_rule" />

    <FrameLayout
        android:id="@+id/fl_trailer_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:minHeight="220dp">

        <WebView
            android:id="@+id/wv_trailer"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <ProgressBar
            android:id="@+id/pb_trailer_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_trailer_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/trailer_in_app_error"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/btn_trailer_open_external"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_exp_button_primary"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/trailer_open_in_youtube"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
