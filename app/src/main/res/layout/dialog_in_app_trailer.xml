<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trailer_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF0A0A0C"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_trailer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:text="@string/movie_trailer"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_trailer_youtube"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trailer_open_in_youtube"
            android:padding="8dp"
            android:src="@drawable/ic_trailer_play"
            android:tint="#FFFFFFFF"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btn_trailer_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/exp_cd_close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#CCFFFFFF"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <View
        android:id="@+id/v_trailer_accent_rule"
        android:layout_width="36dp"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="#E6FFFFFF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_trailer_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:minHeight="200dp">

        <WebView
            android:id="@+id/wv_trailer"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <ProgressBar
            android:id="@+id/pb_trailer_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/ll_trailer_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_trailer_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/trailer_in_app_error"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_trailer_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_featured_cta_secondary"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/loading_error_retry"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_trailer_error_youtube"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_featured_cta_primary"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/trailer_open_in_youtube"
                    android:textColor="#121218"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/btn_trailer_open_external"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_featured_cta_secondary"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:text="@string/trailer_open_in_youtube"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
