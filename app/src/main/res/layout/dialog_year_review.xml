<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- Hero card: year + headline stat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_year_review_hero"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_year_review_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:maxLines="1"
                    android:textColor="#F2FFFFFF"
                    android:textSize="13sp"
                    tools:text="Alex · estimated from finished titles" />

                <TextView
                    android:id="@+id/tv_year_review_switch_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/manrope"
                    android:paddingStart="8dp"
                    android:paddingBottom="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="View 2024"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_year_review_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/syne"
                android:letterSpacing="-0.02"
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:textStyle="bold"
                tools:text="126.5" />

            <TextView
                android:id="@+id/tv_year_review_hours_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.06"
                android:text="@string/year_review_hours_label"
                android:textAllCaps="true"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_year_review_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="18 movies · 214 episodes" />
        </LinearLayout>

        <!-- Top series card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_year_review_top_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.08"
                android:text="@string/year_review_top_series"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_year_review_top_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope"
                android:lineSpacingExtra="6dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                tools:text="1. The Bear — 12 eps\n2. Severance — 10 eps" />
        </LinearLayout>

        <!-- Longest binge card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tv_year_review_binge_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.08"
                android:text="@string/year_review_longest_binge"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_year_review_binge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope"
                android:lineSpacingExtra="6dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                tools:text="The Bear · 8 episodes · ~6h\nMar 12 – Mar 12" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_year_review_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/year_review_empty"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="gone" />

        <ProgressBar
            android:id="@+id/pb_year_review_loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
