<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tg_gate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tg_gate_atmosphere"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/v_tg_gate_orb_a"
        android:layout_width="@dimen/tg_gate_orb_large"
        android:layout_height="@dimen/tg_gate_orb_large"
        android:layout_gravity="top|end"
        android:layout_marginTop="-88dp"
        android:layout_marginEnd="-110dp"
        android:alpha="0.55"
        android:background="@drawable/bg_tg_gate_orb"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/v_tg_gate_orb_b"
        android:layout_width="@dimen/tg_gate_orb_small"
        android:layout_height="@dimen/tg_gate_orb_small"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-72dp"
        android:layout_marginBottom="96dp"
        android:alpha="0.4"
        android:background="@drawable/bg_community_invite_orb_discord"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tg_gate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/tg_gate_pad_h"
            android:paddingTop="@dimen/tg_gate_pad_v"
            android:paddingEnd="@dimen/tg_gate_pad_h"
            android:paddingBottom="@dimen/tg_gate_pad_v">

            <ImageButton
                android:id="@+id/btn_tg_gate_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tg_gate_close_cd"
                android:padding="10dp"
                android:src="@drawable/ic_support_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/support_text_primary" />

            <TextView
                android:id="@+id/tv_tg_gate_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="start"
                android:letterSpacing="-0.03"
                android:text="@string/tg_gate_brand"
                android:textAppearance="@style/TextAppearance.Lumina.Brand"
                android:textColor="@color/support_text_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_tg_gate_close" />

            <View
                android:id="@+id/v_tg_gate_brand_rule"
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:background="@color/support_accent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_tg_gate_brand" />

            <TextView
                android:id="@+id/tv_tg_gate_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="start"
                android:letterSpacing="-0.02"
                android:text="@string/tg_gate_headline"
                android:textAppearance="@style/TextAppearance.Lumina.Title"
                android:textColor="@color/support_text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_tg_gate_brand_rule" />

            <TextView
                android:id="@+id/tv_tg_gate_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:lineSpacingExtra="3dp"
                android:text="@string/tg_gate_body"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="@color/support_text_secondary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_tg_gate_headline" />

            <HorizontalScrollView
                android:id="@+id/hsv_tg_gate_benefits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_tg_gate_body">

                <LinearLayout
                    android:id="@+id/ll_tg_gate_benefits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_tg_gate_benefit_updates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tg_gate_benefit_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/tg_gate_benefit_updates_short"
                        android:textAppearance="@style/TextAppearance.Lumina.Caption"
                        android:textColor="@color/support_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_tg_gate_benefit_support"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tg_gate_benefit_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/tg_gate_benefit_support_short"
                        android:textAppearance="@style/TextAppearance.Lumina.Caption"
                        android:textColor="@color/support_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_tg_gate_benefit_community"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tg_gate_benefit_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/tg_gate_benefit_community_short"
                        android:textAppearance="@style/TextAppearance.Lumina.Caption"
                        android:textColor="@color/support_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Telegram channel card -->
            <LinearLayout
                android:id="@+id/row_tg_gate_telegram"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_tg_gate_card_telegram"
                android:orientation="vertical"
                android:padding="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hsv_tg_gate_benefits">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <ImageView
                            android:id="@+id/iv_tg_gate_telegram_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_tg_gate_icon_chip_telegram"
                            android:contentDescription="@string/tg_gate_telegram_cd"
                            android:padding="12dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_telegram" />

                        <ProgressBar
                            android:id="@+id/pb_tg_gate_telegram"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/tg_gate_telegram"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_tg_gate_telegram_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tg_gate_telegram_title"
                            android:textAppearance="@style/TextAppearance.Lumina.Title"
                            android:textColor="@color/support_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_tg_gate_telegram_handle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tg_gate_channel_chip"
                            android:textAppearance="@style/TextAppearance.Lumina.Caption"
                            android:textColor="@color/tg_gate_telegram_bright"
                            android:textSize="13sp"
                            tools:text="@BetterStreamflix" />

                        <TextView
                            android:id="@+id/tv_tg_gate_telegram_members"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/tg_gate_members_loading"
                            android:textAppearance="@style/TextAppearance.Lumina.Caption"
                            android:textColor="@color/support_text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tg_gate_open"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_tg_gate_btn_telegram"
                    android:gravity="center"
                    android:text="@string/tg_gate_cta_join_telegram"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/tg_gate_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Discord card -->
            <LinearLayout
                android:id="@+id/row_tg_gate_discord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tg_gate_card_discord"
                android:orientation="vertical"
                android:padding="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/row_tg_gate_telegram">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp">

                        <ImageView
                            android:id="@+id/iv_tg_gate_discord_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_tg_gate_icon_chip_discord"
                            android:contentDescription="@string/tg_gate_discord_cd"
                            android:padding="12dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_discord" />

                        <ProgressBar
                            android:id="@+id/pb_tg_gate_discord"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/tg_gate_discord"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_tg_gate_discord_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tg_gate_discord_title"
                            android:textAppearance="@style/TextAppearance.Lumina.Title"
                            android:textColor="@color/support_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_tg_gate_discord_handle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tg_gate_discord_handle"
                            android:textAppearance="@style/TextAppearance.Lumina.Caption"
                            android:textColor="@color/tg_gate_discord_bright"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_tg_gate_discord_members"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/tg_gate_members_loading"
                            android:textAppearance="@style/TextAppearance.Lumina.Caption"
                            android:textColor="@color/support_text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tg_gate_discord_open"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_tg_gate_btn_discord"
                    android:gravity="center"
                    android:text="@string/tg_gate_cta_join_discord"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/tg_gate_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_tg_gate_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/tg_gate_hint_optional"
                android:textAppearance="@style/TextAppearance.Lumina.Caption"
                android:textColor="@color/support_text_tertiary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/row_tg_gate_discord" />

            <TextView
                android:id="@+id/btn_tg_gate_continue"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_support_btn_secondary"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tg_gate_cta_continue"
                android:textAppearance="@style/TextAppearance.Lumina.Title"
                android:textColor="@color/support_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_tg_gate_hint" />

            <!-- Legacy ids kept invisible so old binding references compile during transition -->
            <TextView
                android:id="@+id/tv_tg_gate_channel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/fl_tg_gate_icon_wrap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <View
                    android:id="@+id/v_tg_gate_ring_outer"
                    android:layout_width="1dp"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/v_tg_gate_ring_mid"
                    android:layout_width="1dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/iv_tg_gate_icon"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_tg_gate_opened_stage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_tg_gate_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ll_tg_gate_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/v_tg_gate_step1"
                        android:layout_width="1dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tv_tg_gate_step1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/v_tg_gate_step2"
                        android:layout_width="1dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tv_tg_gate_step2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/v_tg_gate_step3"
                        android:layout_width="1dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tv_tg_gate_step3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_tg_gate_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_tg_gate_copy_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btn_tg_gate_debug_skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="10dp"
                android:text="@string/tg_gate_debug_skip"
                android:textColor="@color/support_text_tertiary"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_tg_gate_continue"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
