<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_detail_trailer_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/syne"
        android:text="@string/detail_tab_trailer"
        android:textColor="@color/cinema_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_detail_trailer_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cinema_accent_rule"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_detail_trailer_label"
        app:layout_constraintTop_toBottomOf="@id/tv_detail_trailer_label"
        tools:visibility="visible" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hgv_detail_trailers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="70dp"
        android:paddingTop="26dp"
        android:paddingEnd="70dp"
        android:paddingBottom="12dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_detail_trailer_rule"
        tools:listitem="@layout/item_trailer_tv" />

    <TextView
        android:id="@+id/btn_detail_trailer_stream_now"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_featured_cta_primary"
        android:focusable="true"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:minWidth="280dp"
        android:nextFocusUp="@id/hgv_detail_trailers"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/trailer_stream_now"
        android:textColor="@color/cinema_cta_ink"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hgv_detail_trailers"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_trailer_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/manrope"
        android:minHeight="120dp"
        android:text="@string/detail_trailer_empty"
        android:textColor="@color/cinema_text_muted"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_detail_trailer_rule"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
