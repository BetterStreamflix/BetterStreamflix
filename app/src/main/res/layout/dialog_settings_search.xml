<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <EditText
        android:id="@+id/et_settings_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_profile_field"
        android:hint="@string/settings_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/cinema_text"
        android:textColorHint="@color/cinema_text_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_settings_search_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/settings_search_empty"
        android:textColor="@color/cinema_text_muted"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        tools:itemCount="4"
        tools:listitem="@layout/item_settings_search_result" />
</LinearLayout>
