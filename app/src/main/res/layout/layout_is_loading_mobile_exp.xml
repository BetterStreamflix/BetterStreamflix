<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    android:clickable="true"
    android:focusable="true"
    android:visibility="visible"
    tools:visibility="gone">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sh_is_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="?attr/colorSurfaceContainerHigh"
        app:shimmer_highlight_color="?attr/colorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="140dp">

            <View
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_exp_skeleton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_exp_skeleton" />
            </LinearLayout>

            <View
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_exp_skeleton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_exp_skeleton" />
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <ProgressBar
        android:id="@+id/pb_is_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:indeterminateTintMode="src_atop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_is_loading_error_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_exp_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_is_loading_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="380dp">

        <TextView
            android:id="@+id/tv_is_loading_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_exp_error"
            android:drawablePadding="14dp"
            android:drawableTint="?attr/colorPrimary"
            android:gravity="center"
            android:text="@string/loading_error_title"
            android:textAppearance="@style/TextAppearance.Nocturne.Brand"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_is_loading_error_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/loading_error_body"
            android:textAppearance="@style/TextAppearance.Nocturne.Body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_is_loading_retry"
        style="@style/AppTheme.Widget.Mobile.Button.Exp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/loading_error_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_is_loading_error_card" />

    <TextView
        android:id="@+id/btn_is_loading_clear_cache"
        style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading_error_clear_cache"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_is_loading_retry" />

    <TextView
        android:id="@+id/btn_is_loading_error_details"
        style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading_error_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_is_loading_clear_cache" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_is_loading_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="ll_is_loading_error_card,btn_is_loading_retry,btn_is_loading_clear_cache,btn_is_loading_error_details"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
