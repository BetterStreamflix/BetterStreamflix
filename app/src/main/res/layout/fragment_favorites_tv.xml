<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_favorites_reorder_mode"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/bg_favorites_action_tv"
        android:backgroundTint="@null"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:stateListAnimator="@animator/item_season_tv_zoom"
        android:text="@string/favorites_rearrange_on"
        android:textColor="@color/favorites_action_text_tv"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_favorites_reorder"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_favorites_reorder"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_favorites_action_tv"
        android:backgroundTint="@null"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:stateListAnimator="@animator/item_season_tv_zoom"
        android:text="@string/favorites_reorder_categories"
        android:textColor="@color/favorites_action_text_tv"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/favorites_actions_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btn_favorites_reorder_mode,btn_favorites_reorder" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favorites_actions_bottom" />

    <TextView
        android:id="@+id/tv_favorites_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_favorite_disable"
        android:drawablePadding="18dp"
        android:gravity="center"
        android:padding="48dp"
        android:text="@string/favorites_empty"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_favorites_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="520dp"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_favorites_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_favorites_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_favorites_empty"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_favorites_empty_cta"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="@string/exp_empty_browse_catalog"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_favorites_empty"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_empty"
        app:layout_constraintTop_toBottomOf="@id/v_favorites_empty_rule"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
