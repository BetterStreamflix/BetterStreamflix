<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.people.PeopleTvFragment">

    <ImageView
        android:id="@+id/iv_people_backdrop"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_people_backdrop_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_people_header_scrim"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_people_backdrop"
        app:layout_constraintEnd_toEndOf="@id/iv_people_backdrop"
        app:layout_constraintStart_toStartOf="@id/iv_people_backdrop"
        app:layout_constraintTop_toTopOf="@id/iv_people_backdrop"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_people_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/iv_people_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="People name" />

    <TextView
        android:id="@+id/tv_people_department"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_people_department_chip"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_name"
        tools:text="Acting"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_people_birthday_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="10dp"
        android:text="@string/people_birthday"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_department" />

    <TextView
        android:id="@+id/tv_people_birthday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/iv_people_image"
        app:layout_constraintStart_toEndOf="@id/tv_people_birthday_label"
        app:layout_constraintTop_toBottomOf="@id/tv_people_department"
        tools:text="Birthday" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_birthday_label,tv_people_birthday"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/b_people_birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_people_birthday_label,tv_people_birthday" />

    <TextView
        android:id="@+id/tv_people_deathday_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="@string/people_deathday"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_birthday" />

    <TextView
        android:id="@+id/tv_people_deathday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/iv_people_image"
        app:layout_constraintStart_toEndOf="@id/tv_people_deathday_label"
        app:layout_constraintTop_toBottomOf="@id/b_people_birthday"
        tools:text="Day of death" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_deathday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_deathday_label,tv_people_deathday"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/b_people_deathday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_people_deathday_label,tv_people_deathday" />

    <TextView
        android:id="@+id/tv_people_birthplace_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="4dp"
        android:text="@string/people_birthplace"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/b_people_deathday" />

    <TextView
        android:id="@+id/tv_people_birthplace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/iv_people_image"
        app:layout_constraintStart_toEndOf="@id/tv_people_birthplace_label"
        app:layout_constraintTop_toBottomOf="@id/b_people_deathday"
        tools:text="Place of birth" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_birthplace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_birthplace_label,tv_people_birthplace"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_people_image"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_item_people_image"
        android:duplicateParentState="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:clipToOutline="true"
        tools:ignore="ContentDescription"
        tools:src="@drawable/ic_person_placeholder" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_people_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_people_birthplace_label,tv_people_birthplace,iv_people_image" />

    <TextView
        android:id="@+id/tv_people_biography_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="40dp"
        android:text="@string/people_biography"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_people_meta" />

    <TextView
        android:id="@+id/tv_people_biography"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="#CCFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_biography_label"
        tools:text="Biography" />

    <TextView
        android:id="@+id/tv_people_biography_read_more"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:focusable="true"
        android:text="@string/people_read_more"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_people_biography"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_people_biography"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_people_biography_label,tv_people_biography,tv_people_biography_read_more"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_people_biography_label,tv_people_biography,tv_people_biography_read_more,barrier_people_meta" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_people_filmography"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="16dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        app:numberOfColumns="6"
        tools:listitem="@layout/item_movie_grid_tv" />

    <TextView
        android:id="@+id/tv_people_filmography_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="48dp"
        android:text="@string/people_filmography_empty"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_people_filmography_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="520dp"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_people_filmography_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_people_filmography_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_people_filmography_empty"
        app:layout_constraintStart_toStartOf="@id/tv_people_filmography_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_people_filmography_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_people_filmography_empty_cta"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="@string/exp_empty_back"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_people_filmography_empty"
        app:layout_constraintStart_toStartOf="@id/tv_people_filmography_empty"
        app:layout_constraintTop_toBottomOf="@id/v_people_filmography_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>