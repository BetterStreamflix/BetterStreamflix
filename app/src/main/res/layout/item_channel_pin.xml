<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="2dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_channel_pin_ring"
        android:padding="3dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_channel_pin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_people_circle"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumina.Circle"
            tools:ignore="ContentDescription"
            tools:src="@drawable/ic_person_placeholder" />

        <TextView
            android:id="@+id/tv_channel_pin_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_live_indicator"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="@string/player_live_badge"
            android:textColor="@color/cinema_text"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_channel_pin_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:textColor="@color/cinema_text"
        android:textSize="11sp"
        tools:text="ESPN" />
</LinearLayout>
