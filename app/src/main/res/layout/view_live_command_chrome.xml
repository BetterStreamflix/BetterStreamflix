<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_command_chrome"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <HorizontalScrollView
        android:id="@+id/hsv_live_command_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_live_command_modes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_live_command_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_search_edittext">

        <ImageView
            android:id="@+id/iv_live_command_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/live_command_cd_search"
            android:padding="10dp"
            android:src="@drawable/ic_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <EditText
            android:id="@+id/et_live_command_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="@font/manrope"
            android:hint="@string/live_command_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusDown="@id/ll_live_command_actions"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_live_command_search_clear"
            app:layout_constraintStart_toEndOf="@id/iv_live_command_search"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_live_command_search_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/live_command_cd_clear_search"
            android:padding="10dp"
            android:src="@drawable/ic_search_clear"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFFFF"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_live_command_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_live_command_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_live_command_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxLines="2"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:textColor="@color/cinema_text_soft"
        android:textSize="12sp"
        tools:text="Sport zap ready · warm ±2" />
</LinearLayout>
