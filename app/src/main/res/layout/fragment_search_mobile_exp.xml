<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    tools:context=".fragments.search.SearchMobileFragment">

    <TextView
        android:id="@+id/tv_search_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="22dp"
        android:letterSpacing="0.12"
        android:text="@string/exp_catalog_eyebrow"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Nocturne.Eyebrow"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_search_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/main_menu_search"
        android:textAppearance="@style/TextAppearance.Nocturne.Hero"
        app:layout_constraintEnd_toEndOf="@id/tv_search_eyebrow"
        app:layout_constraintStart_toStartOf="@id/tv_search_eyebrow"
        app:layout_constraintTop_toBottomOf="@id/tv_search_eyebrow" />

    <TextView
        android:id="@+id/tv_search_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exp_search_tagline"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_search_brand"
        app:layout_constraintStart_toStartOf="@id/tv_search_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_search_brand" />

    <View
        android:id="@+id/v_search_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintStart_toStartOf="@id/tv_search_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_search_tagline" />

    <View
        android:id="@+id/v_search_header_fade"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_exp_header_fade"
        android:elevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_search_rule" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_exp_search_field"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_search_header_fade">

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="13dp"
            android:src="@drawable/ic_search"
            android:tint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <EditText
            android:id="@+id/et_search"
            android:textAppearance="@style/TextAppearance.Nocturne.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="@string/search_input_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_search_clear"
            app:layout_constraintStart_toEndOf="@id/ic_search"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="Autofill,UnusedAttribute" />

        <ImageView
            android:id="@+id/btn_search_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/exp_cd_search_clear"
            android:padding="13dp"
            android:src="@drawable/ic_search_clear"
            android:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@id/btn_search_voice"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_search_voice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/exp_cd_voice_search"
            android:padding="13dp"
            android:src="@drawable/ic_mic"
            android:tint="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/sw_global_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/global_search"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/cl_search"
        app:thumbTint="?attr/colorPrimary"
        app:trackTint="?attr/colorPrimaryContainer" />

    <HorizontalScrollView
        android:id="@+id/hsv_search_recent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/cl_search"
        app:layout_constraintStart_toStartOf="@id/cl_search"
        app:layout_constraintTop_toBottomOf="@id/sw_global_search"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_search_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:id="@+id/v_search_recent_edge_fade_start"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_start"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hsv_search_recent"
        app:layout_constraintStart_toStartOf="@id/hsv_search_recent"
        app:layout_constraintTop_toTopOf="@id/hsv_search_recent" />

    <View
        android:id="@+id/v_search_recent_edge_fade_end"
        android:layout_width="36dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_end"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/hsv_search_recent"
        app:layout_constraintEnd_toEndOf="@id/hsv_search_recent"
        app:layout_constraintTop_toTopOf="@id/hsv_search_recent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_search_recent"
        app:spanCount="3"
        tools:listitem="@layout/item_movie_grid_mobile_exp" />

    <TextView
        android:id="@+id/tv_search_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_exp_glass_card"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorPrimary"
        android:gravity="center"
        android:padding="28dp"
        android:text="@string/search_no_results"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_search_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_search_recent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="360dp" />

    <View
        android:id="@+id/v_search_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_search_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_search_empty"
        app:layout_constraintStart_toStartOf="@id/tv_search_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_search_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_search_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/exp_empty_clear_search"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_search_empty"
        app:layout_constraintStart_toStartOf="@id/tv_search_empty"
        app:layout_constraintTop_toBottomOf="@id/v_search_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile_exp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/rv_search"
        app:layout_constraintEnd_toEndOf="@id/rv_search"
        app:layout_constraintStart_toStartOf="@id/rv_search"
        app:layout_constraintTop_toTopOf="@id/rv_search" />

</androidx.constraintlayout.widget.ConstraintLayout>
