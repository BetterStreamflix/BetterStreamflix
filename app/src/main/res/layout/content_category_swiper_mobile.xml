<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="6dp">

    <!-- Full-bleed Featured hero — edge-to-edge under floating home chrome. -->
    <FrameLayout
        android:id="@+id/fl_category_swiper_card"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_featured_card_height"
        android:background="@drawable/bg_featured_card"
        android:clipChildren="true"
        android:clipToPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_category_swiper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/ll_dots_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:elevation="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Featured"
        tools:visibility="gone" />

    <ProgressBar
        android:id="@+id/pb_swiper_auto_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#FFFFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fl_category_swiper_card"
        app:layout_constraintEnd_toEndOf="@id/fl_category_swiper_card"
        app:layout_constraintStart_toStartOf="@id/fl_category_swiper_card" />

</androidx.constraintlayout.widget.ConstraintLayout>
