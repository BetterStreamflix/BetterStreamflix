<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    tools:context=".fragments.home.HomeMobileFragment">

    <ImageView
        android:id="@+id/iv_home_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foreground="@drawable/bg_exp_home_hero"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/v_home_atmosphere"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_lumina_veil"
        app:layout_constraintBottom_toBottomOf="@id/iv_home_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_home_glow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_glow"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="168dp"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:itemCount="1"
        tools:listitem="@layout/content_category_swiper_mobile_exp" />

    <ImageView
        android:id="@+id/iv_provider_logo"
        android:layout_width="44dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_provider_logo_home_exp"
        android:clickable="true"
        android:contentDescription="@string/providers_choose_title"
        android:elevation="4dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_home_greeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nocturne.Eyebrow"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toStartOf="@id/tv_home_profile_chip"
        app:layout_constraintStart_toEndOf="@id/iv_provider_logo"
        app:layout_constraintTop_toTopOf="@id/iv_provider_logo"
        tools:text="Good evening, Alex" />

    <TextView
        android:id="@+id/tv_home_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Nocturne.Hero"
        android:textSize="30sp"
        app:layout_constraintEnd_toStartOf="@id/tv_home_profile_chip"
        app:layout_constraintStart_toStartOf="@id/tv_home_greeting"
        app:layout_constraintTop_toBottomOf="@id/tv_home_greeting" />

    <TextView
        android:id="@+id/tv_home_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:elevation="4dp"
        android:text="@string/exp_home_tagline"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_home_brand"
        app:layout_constraintStart_toStartOf="@id/tv_home_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_home_brand" />

    <TextView
        android:id="@+id/tv_home_provider_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_home_brand"
        app:layout_constraintTop_toBottomOf="@id/v_home_brand_rule"
        tools:text="Watching via SerienStream"
        tools:visibility="gone" />

    <View
        android:id="@+id/v_home_brand_rule"
        android:layout_width="28dp"
        android:layout_height="1.5dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_home_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_home_tagline" />

    <View
        android:id="@+id/v_home_header_fade"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_exp_header_fade"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_home_brand_rule" />

    <Space
        android:id="@+id/btn_home_search_spacer"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/tv_home_profile_chip"
        layout="@layout/view_profile_home_chip"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/tv_home_brand"
        app:layout_constraintEnd_toStartOf="@id/btn_home_search_spacer"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@id/iv_provider_logo"
        app:layout_constraintTop_toTopOf="@id/tv_home_greeting" />

    <TextView
        android:id="@+id/tv_home_catalog_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_exp_meta_pill"
        android:clickable="true"
        android:elevation="6dp"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="2"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_home_brand_rule"
        tools:text="Catalog unavailable — showing cache"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_home_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_exp_glass_card"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorPrimary"
        android:gravity="center"
        android:padding="28dp"
        android:text="@string/home_empty"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_home_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="360dp"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_home_empty_rule"
        android:layout_width="28dp"
        android:layout_height="1.5dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_home_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_home_empty"
        app:layout_constraintStart_toStartOf="@id/tv_home_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_home_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_home_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/exp_empty_choose_provider"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_home_empty"
        app:layout_constraintStart_toStartOf="@id/tv_home_empty"
        app:layout_constraintTop_toBottomOf="@id/v_home_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile_exp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
