<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    tools:context=".fragments.tv_shows.TvShowsMobileFragment">

    <TextView
        android:id="@+id/tv_tv_shows_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="22dp"
        android:letterSpacing="0.12"
        android:text="@string/exp_catalog_eyebrow"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_tv_shows_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:text="@string/main_menu_tv_shows"
        android:textAppearance="@style/TextAppearance.Lumina.Hero"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_shows_sort_chip"
        app:layout_constraintStart_toStartOf="@id/tv_tv_shows_eyebrow"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_shows_eyebrow" />

    <TextView
        android:id="@+id/tv_tv_shows_sort_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_exp_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/catalog_sort_default"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/tv_tv_shows_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_tv_shows_brand" />

    <TextView
        android:id="@+id/tv_tv_shows_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exp_tv_shows_tagline"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_shows_brand"
        app:layout_constraintStart_toStartOf="@id/tv_tv_shows_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_shows_brand" />

    <View
        android:id="@+id/v_tv_shows_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintStart_toStartOf="@id/tv_tv_shows_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_shows_tagline" />

    <View
        android:id="@+id/v_tv_shows_header_fade"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_exp_header_fade"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_tv_shows_rule" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tv_shows"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="132dp"
        android:paddingEnd="14dp"
        android:paddingBottom="110dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:spanCount="3"
        tools:listitem="@layout/item_tv_show_grid_mobile_exp" />

        <TextView
        android:id="@+id/tv_tv_shows_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_exp_glass_card"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorPrimary"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/tv_shows_empty"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_tv_shows_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="360dp"
        tools:visibility="visible" />

    
    <View
        android:id="@+id/v_tv_shows_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_tv_shows_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_shows_empty"
        app:layout_constraintStart_toStartOf="@id/tv_tv_shows_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_shows_empty"
        tools:visibility="visible" />

<TextView
        android:id="@+id/btn_tv_shows_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/exp_empty_choose_provider"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_tv_shows_empty"
        app:layout_constraintStart_toStartOf="@id/tv_tv_shows_empty"
        app:layout_constraintTop_toBottomOf="@id/v_tv_shows_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile_exp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
