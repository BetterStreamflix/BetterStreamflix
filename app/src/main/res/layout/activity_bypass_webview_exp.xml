<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/bypass_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_exp_progress_track" />

    <TextView
        android:id="@+id/tv_bypass_eyebrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="14dp"
        android:text="@string/exp_catalog_eyebrow"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        android:textColor="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tv_bypass_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:text="@string/exp_bypass_brand"
        android:textAppearance="@style/TextAppearance.Lumina.Title"
        android:textColor="?attr/colorOnSurface" />

    <View
        android:id="@+id/v_bypass_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_exp_accent_rule" />

    <TextView
        android:id="@+id/bypass_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_exp_glass_card"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:text="@string/bypass_status_complete_in_page"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp" />

    <WebView
        android:id="@+id/bypass_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="?attr/colorSurface" />

    <LinearLayout
        android:id="@+id/bypass_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_exp_nav_pill"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/bypass_cancel"
            style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bypass_action_cancel" />

        <Button
            android:id="@+id/bypass_continue"
            style="@style/AppTheme.Widget.Mobile.Button.Exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:enabled="false"
            android:text="@string/bypass_action_continue" />

    </LinearLayout>

</LinearLayout>
