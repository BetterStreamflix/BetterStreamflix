<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/tv_detail_about_overview_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.06"
        android:text="@string/detail_about_overview_label"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_detail_about_overview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="5dp"
        android:textColor="#F2FFFFFF"
        android:textSize="15sp"
        tools:text="Follow everyone's favorite troublemakers as they navigate school, friendship, and absurdity in South Park, Colorado." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="6dp"
        android:background="#22FFFFFF" />

    <TextView
        android:id="@+id/tv_detail_about_featuring_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.06"
        android:text="@string/detail_about_featuring_label"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_about_featuring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Trey Parker, Matt Stone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_about_directors_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.06"
        android:text="@string/detail_about_directors_label"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_about_directors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Jane Doe"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_about_cast_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.06"
        android:text="@string/detail_about_cast_label"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_about_cast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Actor One, Actor Two, Actor Three"
        tools:visibility="visible" />
</LinearLayout>
