<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background_color"
    tools:context=".fragments.live.LiveHubTvFragment">

    <include
        android:id="@+id/tv_home_profile_chip"
        layout="@layout/view_profile_home_chip"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_live_hub_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxLines="1"
        android:nextFocusLeft="@id/nav_main"
        android:nextFocusDown="@id/live_command_chrome"
        android:nextFocusRight="@id/tv_home_profile_chip"
        android:text="@string/live_hub_title"
        android:textColor="@color/cinema_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_home_profile_chip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_live_hub_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxLines="2"
        android:nextFocusLeft="@id/nav_main"
        android:nextFocusRight="@id/tv_home_profile_chip"
        android:text="@string/live_hub_tagline"
        android:textColor="@color/cinema_text_muted"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/tv_home_profile_chip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_live_hub_brand" />

    <include
        android:id="@+id/live_command_chrome"
        layout="@layout/view_live_command_chrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_live_hub_tagline" />

    <TextView
        android:id="@+id/tv_live_hub_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_home_catalog_warning"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/manrope"
        android:maxLines="2"
        android:nextFocusDown="@id/vgv_live_hub"
        android:padding="12dp"
        android:textColor="@color/cinema_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/live_command_chrome"
        tools:visibility="visible" />

    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_live_hub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:nextFocusLeft="@id/nav_main"
        android:nextFocusUp="@id/live_command_chrome"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:focusOutSideEnd="true"
        app:focusOutSideStart="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_live_hub_warning"
        app:numberOfColumns="1"
        tools:itemCount="3"
        tools:listitem="@layout/item_category_tv" />

    <TextView
        android:id="@+id/tv_live_hub_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="48dp"
        android:text="@string/live_hub_empty_tv"
        android:textColor="@color/cinema_text_muted"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_live_hub_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="520dp"
        tools:visibility="gone" />

    <View
        android:id="@+id/v_live_hub_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_cinema_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_live_hub_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_live_hub_empty"
        app:layout_constraintStart_toStartOf="@id/tv_live_hub_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_live_hub_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_live_hub_empty_cta"
        style="@style/AppTheme.Widget.Tv.Button.FeaturedPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:text="@string/exp_empty_try_channel"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_live_hub_empty"
        app:layout_constraintStart_toStartOf="@id/tv_live_hub_empty"
        app:layout_constraintTop_toBottomOf="@id/v_live_hub_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
