<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cinema_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <FrameLayout
        android:id="@+id/fl_exo_title_slot"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@id/tv_cast_queue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_exo_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:scaleType="fitStart"
            android:visibility="invisible"
            tools:src="@mipmap/ic_launcher"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_exo_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/cinema_text"
            android:textSize="34sp"
            tools:text="Title" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_exo_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/cinema_text_soft"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@id/tv_cast_queue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_exo_title_slot"
        tools:text="Description" />

    <TextView
        android:id="@+id/tv_cast_queue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_live_indicator"
        android:contentDescription="@string/player_cast_queue_badge_cd"
        android:ellipsize="end"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/cinema_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/media_route_button"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:text="Cast queue · 1"
        tools:visibility="visible" />

    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/media_route_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/player_cast_content_description"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:mediaRouteTypes="user"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_watch_party"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/btn_exo_watch_party"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/watch_party_cd"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_detail_share"
        android:tint="@color/cinema_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_cast_handoff"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/btn_exo_cast_handoff"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/cast_handoff_cd"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_update_arrow_right"
        android:tint="@color/cinema_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_cast_room"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/btn_exo_cast_room"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/cast_room_cd"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_menu_tv"
        android:tint="@color/cinema_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_session_handoff"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:ignore="UseAppTint" />

    <ImageView
        android:id="@+id/btn_exo_session_handoff"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/session_handoff_cd"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_session_handoff"
        android:tint="@color/cinema_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/btn_exo_external_player"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/bg_btn_exoplayer_tv"
        android:contentDescription="@string/exp_cd_external_player"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/player_play_with_chrome"
        android:textColor="@color/cinema_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:drawableStartCompat="@drawable/exo_styled_controls_external_player"
        app:drawableTint="@color/cinema_text"
        app:layout_constraintBottom_toBottomOf="@id/tv_exo_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/fl_exo_title_slot"
        tools:ignore="PrivateResource" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_custom_prev"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_prev_episode"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_previous"
            app:tint="@color/cinema_text" />

        <ImageView
            android:id="@+id/exo_rew"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_rewind"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_rewind"
            android:tint="@color/cinema_text"
            tools:ignore="PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/exo_replay"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_replay"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/cinema_text" />

        <ImageView
            android:id="@id/exo_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_play_pause"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/exo_settings"
            android:padding="2dp"
            android:src="@drawable/exo_styled_controls_play"
            android:tint="@color/cinema_text"
            tools:ignore="PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/exo_ffwd"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_forward"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:tint="@color/cinema_text"
            tools:ignore="PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_custom_next"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_next_episode"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tv_exo_subtitle"
            android:nextFocusDown="@id/exo_bottom_bar"
            android:padding="10dp"
            android:src="@drawable/ic_next"
            app:tint="@color/cinema_text" />

    </LinearLayout>

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/exo_settings"
        app:layout_constraintBottom_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_live_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_indicator"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/player_live_badge"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btn_go_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_go_live_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/player_go_live"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_live_indicator"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_live_channel_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/cinema_text_muted"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_aspect_ratio"
            app:layout_constraintStart_toEndOf="@id/btn_go_live"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="CH 12 · News"
            tools:visibility="visible" />

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <TextView
            android:id="@+id/tv_time_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="·"
            android:textColor="@color/cinema_text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/exo_position"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cinema_text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_time_separator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00:00" />

        <ImageView
            android:id="@id/btn_exo_aspect_ratio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_aspect_ratio"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_aspect_ratio"
            android:nextFocusRight="@id/btn_exo_audio"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_aspect_ratio"
            android:tint="@color/cinema_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_audio"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_exo_audio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_audio"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_aspect_ratio"
            android:nextFocusRight="@id/exo_settings"
            android:padding="12dp"
            android:src="@drawable/ic_player_settings_audio"
            android:tint="@color/cinema_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exo_settings"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseAppTint" />

        <ImageView
            android:id="@id/exo_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_btn_exoplayer_tv"
            android:contentDescription="@string/exp_cd_settings"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_audio"
            android:nextFocusRight="@id/exo_settings"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_settings"
            android:tint="@color/cinema_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/selector_skip_intro_button"
        android:drawableStart="@drawable/exo_styled_controls_fastforward"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/player_skip_intro"
        android:textColor="@color/cinema_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>