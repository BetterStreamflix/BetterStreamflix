<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="24dp"
    android:paddingBottom="10dp"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_category_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <View
        android:id="@+id/v_category_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintStart_toStartOf="@id/tv_category_title"
        app:layout_constraintTop_toBottomOf="@id/tv_category_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="28dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_category_rule"
        tools:listitem="@layout/item_movie_mobile_exp" />

    <View
        android:id="@+id/v_category_edge_fade_start"
        android:layout_width="28dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_start"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/rv_category"
        app:layout_constraintStart_toStartOf="@id/rv_category"
        app:layout_constraintTop_toTopOf="@id/rv_category" />

    <View
        android:id="@+id/v_category_edge_fade_end"
        android:layout_width="36dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_edge_fade_end"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/rv_category"
        app:layout_constraintEnd_toEndOf="@id/rv_category"
        app:layout_constraintTop_toTopOf="@id/rv_category" />

</androidx.constraintlayout.widget.ConstraintLayout>
