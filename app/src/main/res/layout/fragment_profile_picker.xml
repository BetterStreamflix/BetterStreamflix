<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_atmosphere"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_profile_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="48dp"
            android:paddingEnd="22dp">

            <ImageView
                android:id="@+id/btn_profile_picker_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_picker_close"
                android:padding="10dp"
                android:src="@drawable/ic_profile_close"
                app:tint="@color/profile_text_secondary" />

            <TextView
                android:id="@+id/tv_profile_picker_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_atelier_brand"
                android:textAppearance="@style/TextAppearance.Nocturne.Eyebrow"
                android:textColor="@color/profile_accent" />

            <TextView
                android:id="@+id/tv_profile_picker_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Nocturne.Caption"
                android:textColor="@color/profile_text_secondary"
                tools:text="Good evening, Alex" />

            <TextView
                android:id="@+id/tv_profile_picker_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="0.96"
                android:text="@string/profile_picker_title"
                android:textAppearance="@style/TextAppearance.Nocturne.Hero"
                android:textColor="@color/profile_text_primary"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/tv_profile_picker_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/profile_picker_subtitle"
                android:textAppearance="@style/TextAppearance.Nocturne.Body"
                android:textColor="@color/profile_text_secondary"
                android:textSize="14sp" />

            <View
                android:id="@+id/v_profile_picker_rule"
                android:layout_width="28dp"
                android:layout_height="1.5dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_exp_accent_rule" />

            <LinearLayout
                android:id="@+id/ll_profile_picker_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_profile_picker_create"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_profile_btn_primary"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/profile_create_title"
                    android:textAppearance="@style/TextAppearance.Nocturne.Caption"
                    android:textColor="@color/profile_on_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_profile_picker_manage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_profile_btn_secondary"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/profile_picker_manage"
                    android:textAppearance="@style/TextAppearance.Nocturne.Caption"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
