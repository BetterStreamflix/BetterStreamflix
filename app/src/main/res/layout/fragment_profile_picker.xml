<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_picker_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog"
    android:clickable="true"
    android:focusable="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_profile_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/btn_profile_picker_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_picker_close"
                android:padding="10dp"
                android:src="@drawable/ic_profile_close"
                app:tint="@color/profile_text_secondary" />

            <ImageView
                android:id="@+id/iv_profile_picker_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/tv_profile_picker_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.12"
                android:text="@string/profile_atelier_brand"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
                android:textColor="@color/profile_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_picker_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:text="@string/profile_picker_title"
                android:textAppearance="@style/TextAppearance.Lumina.Hero"
                android:textColor="@color/profile_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_profile_picker_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/profile_picker_subtitle"
                android:textAppearance="@style/TextAppearance.Lumina.Body"
                android:textColor="@color/profile_text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/v_profile_picker_rule"
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_exp_accent_rule" />

            <LinearLayout
                android:id="@+id/ll_profile_picker_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_profile_picker_create"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_profile_btn_primary"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/profile_create_title"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/profile_on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_profile_picker_manage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_profile_btn_secondary"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/profile_picker_manage"
                    android:textAppearance="@style/TextAppearance.Lumina.Caption"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
