<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profiles_settings_hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_atmosphere"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/profile_settings_hero_eyebrow"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        android:textColor="@color/profile_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginTop="16dp">

        <com.dskja.betterstreamflix.profiles.ProfileAvatarView
            android:id="@+id/pav_profiles_settings_hero"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center" />

        <View
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_profile_avatar_select_ring"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_profiles_settings_hero_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Lumina.Title"
        android:textColor="@color/profile_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Alex" />

    <TextView
        android:id="@+id/tv_profiles_settings_hero_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp"
        tools:text="Gold · Active" />
</LinearLayout>
