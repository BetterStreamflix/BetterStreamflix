<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    tools:context=".fragments.providers.ProvidersMobileFragment">

    <ImageView
        android:id="@+id/iv_providers_language"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_exp_icon_chip"
        android:padding="10dp"
        android:src="@drawable/ic_providers_language"
        android:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/s_providers_language"
        app:layout_constraintEnd_toStartOf="@id/s_providers_language"
        app:layout_constraintTop_toTopOf="@id/s_providers_language"
        tools:ignore="ContentDescription,UseAppTint" />

    <Spinner
        android:id="@+id/s_providers_language"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_exp_spinner"
        android:paddingStart="10dp"
        android:paddingEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_providers_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:letterSpacing="0.12"
        android:text="@string/exp_providers_eyebrow"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Nocturne.Eyebrow"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/s_providers_language" />

    <TextView
        android:id="@+id/tv_providers_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:text="@string/providers_choose_title"
        android:textAppearance="@style/TextAppearance.Nocturne.Brand"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@id/tv_providers_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_providers_eyebrow"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_providers_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:text="@string/providers_choose_subtitle"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/v_providers_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_providers_label" />

    <View
        android:id="@+id/v_providers_rule"
        android:layout_width="44dp"
        android:layout_height="3dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintBottom_toTopOf="@id/v_providers_header_fade"
        app:layout_constraintEnd_toEndOf="@id/tv_providers_label"
        app:layout_constraintStart_toStartOf="@id/tv_providers_label"
        app:layout_constraintTop_toBottomOf="@id/tv_providers_subtitle" />

    <View
        android:id="@+id/v_providers_header_fade"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_exp_header_fade"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/rv_providers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_providers_rule" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_providers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="36dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_providers_header_fade"
        app:spanCount="2"
        tools:itemCount="3"
        tools:listitem="@layout/item_provider_mobile_exp" />

    <TextView
        android:id="@+id/tv_providers_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_exp_glass_card"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorPrimary"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/providers_empty"
        android:textAppearance="@style/TextAppearance.Nocturne.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_providers_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_providers_header_fade"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="360dp"
        tools:visibility="visible" />

    
    <View
        android:id="@+id/v_providers_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_providers_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_providers_empty"
        app:layout_constraintStart_toStartOf="@id/tv_providers_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_providers_empty"
        tools:visibility="visible" />

<TextView
        android:id="@+id/btn_providers_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/exp_empty_all_languages"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Nocturne.Caption"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_providers_empty"
        app:layout_constraintStart_toStartOf="@id/tv_providers_empty"
        app:layout_constraintTop_toBottomOf="@id/v_providers_empty_rule"
        tools:visibility="visible" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile_exp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
