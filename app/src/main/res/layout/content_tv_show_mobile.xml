<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <Space
        android:id="@+id/space_tv_show_hero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/fl_tv_show_logo_slot"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="@id/space_tv_show_hero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_tv_show_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:visibility="invisible"
            tools:src="@mipmap/ic_launcher"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_tv_show_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/syne"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="SOUTH PARK" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="space_tv_show_hero" />

    <TextView
        android:id="@+id/btn_tv_show_watch_now"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_detail_watch_now"
        android:drawablePadding="8dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/tv_show_watch_season_episode"
        android:textAllCaps="true"
        android:textColor="#121218"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand" />

    <LinearLayout
        android:id="@+id/ll_tv_show_cta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_tv_show_watch_now">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/detail_add_to_list"
                android:padding="12dp"
                android:src="@drawable/ic_list_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/detail_action_list"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_trailer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/tv_show_trailer"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trailer_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/detail_action_trailer"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_download"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/option_show_download"
                android:padding="12dp"
                android:src="@drawable/ic_player_settings_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/detail_action_download"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_watched"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/option_show_watched"
                android:padding="12dp"
                android:src="@drawable/ic_watched" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/detail_action_watched"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/detail_share"
                android:padding="12dp"
                android:src="@drawable/ic_detail_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:text="@string/detail_action_share"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#80646464"
        android:progressTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_cta_row"
        tools:progress="80" />

    <LinearLayout
        android:id="@+id/ll_tv_show_meta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode">

        <TextView
            android:id="@+id/tv_tv_show_genres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="COMEDY" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/manrope"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="29 SEASONS" />

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/manrope"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="1997" />

        <TextView
            android:id="@+id/tv_tv_show_certification"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cert_badge"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="16"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta_row"
        tools:text="Overview" />

    <TextView
        android:id="@+id/tv_tv_show_overview_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:minHeight="28dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/detail_overview_more"
        android:textColor="#8AFFFFFF"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
