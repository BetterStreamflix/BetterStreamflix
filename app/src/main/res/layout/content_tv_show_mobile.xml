<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.38"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumina.Poster"
        tools:layout_constraintDimensionRatio="2:3"
        tools:layout_height="0dp" />

    <!-- Share and list actions moved to the sticky detail header. -->
    <ImageView
        android:id="@+id/btn_tv_show_share"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@string/detail_share"
        android:src="@drawable/ic_detail_share"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_tv_show_favorite"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_list_add"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_tv_show_logo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:maxHeight="72dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tv_show_poster" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_tv_show_logo"
        app:layout_goneMarginTop="14dp"
        tools:text="Title" />

    <ImageView
        android:id="@+id/iv_tv_show_rating_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star"
        android:tint="#C0C0C0"
        app:layout_constraintBottom_toBottomOf="@id/tv_tv_show_rating"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_show_rating"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_tv_show_rating"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tv_tv_show_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_show_quality"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_rating_icon"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title"
        tools:text="#.#" />

    <TextView
        android:id="@+id/tv_tv_show_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_show_certification"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_rating"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title"
        tools:text="HD"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_certification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_meta_pill"
        android:fontFamily="@font/manrope"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_show_released"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_quality"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title"
        tools:text="TV-MA"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_released"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintEnd_toStartOf="@id/tv_tv_show_runtime"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_certification"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title"
        tools:text="yyyy"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_released"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_title"
        tools:text="# h # min"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_tv_show_rating,tv_tv_show_quality,tv_tv_show_certification,tv_tv_show_released,tv_tv_show_runtime" />

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        tools:text="Genres" />

    <TextView
        android:id="@+id/btn_tv_show_watch_now"
        style="@style/AppTheme.Widget.Mobile.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="22dp"
        android:text="@string/tv_show_watch_season_episode"
        app:layout_constraintEnd_toStartOf="@id/btn_tv_show_trailer"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        app:layout_goneMarginEnd="10dp" />

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:backgroundTint="#CC646464"
        android:progressTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/btn_tv_show_watch_now"
        tools:progress="80" />

    <TextView
        android:id="@+id/btn_tv_show_trailer"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_trailer_button"
        android:drawableStart="@drawable/ic_trailer_play"
        android:drawablePadding="8dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:text="@string/tv_show_trailer"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btn_tv_show_watch_now"
        app:layout_constraintEnd_toStartOf="@id/btn_tv_show_download"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toTopOf="@id/btn_tv_show_watch_now" />

    <ImageView
        android:id="@+id/btn_tv_show_download"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_detail_icon_chip"
        android:contentDescription="@string/option_show_download"
        android:padding="11dp"
        android:src="@drawable/ic_player_settings_download"
        app:layout_constraintBottom_toBottomOf="@id/btn_tv_show_watch_now"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_trailer"
        app:layout_constraintTop_toTopOf="@id/btn_tv_show_watch_now"
        app:tint="#FFFFFF" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btn_tv_show_watch_now,pb_tv_show_progress_episode,btn_tv_show_trailer,btn_tv_show_download" />

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxLines="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier2"
        tools:text="Overview" />

    <TextView
        android:id="@+id/tv_tv_show_overview_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:minHeight="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/detail_overview_more"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_tv_show_detail_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview_more" />

</androidx.constraintlayout.widget.ConstraintLayout>
