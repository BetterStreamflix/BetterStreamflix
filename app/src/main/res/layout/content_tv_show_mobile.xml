<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="32dp">

    <ImageView
        android:id="@+id/iv_tv_show_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_launcher" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_tv_show_soft_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <ImageView
        android:id="@+id/iv_tv_show_cover_soft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gl_tv_show_soft_start" />

    <View
        android:id="@+id/v_tv_show_cover_veil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_detail_cover_veil"
        app:layout_constraintBottom_toBottomOf="@id/iv_tv_show_cover"
        app:layout_constraintEnd_toEndOf="@id/iv_tv_show_cover"
        app:layout_constraintStart_toStartOf="@id/iv_tv_show_cover"
        app:layout_constraintTop_toTopOf="@id/iv_tv_show_cover" />

    <!-- Legacy poster stub (cover is full-bleed). Kept gone for binding safety. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/space_tv_show_hero"
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_hero_top_inset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Space
        android:id="@+id/space_tv_show_art_stage"
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_art_stage_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_tv_show_hero" />

    <FrameLayout
        android:id="@+id/fl_tv_show_logo_slot"
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_logo_slot_height"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_detail_logo_scrim"
        android:elevation="0dp"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@id/space_tv_show_art_stage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_tv_show_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:visibility="invisible"
            tools:src="@mipmap/ic_launcher"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_tv_show_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:fontFamily="@font/syne"
            android:gravity="start|center_vertical"
            android:maxLines="3"
            android:shadowColor="#F2000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="16"
            android:textColor="@color/cinema_text"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="South Park" />
    </FrameLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="space_tv_show_art_stage" />

    <LinearLayout
        android:id="@+id/ll_tv_show_meta_facts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand">

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/cinema_text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="1997" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/manrope"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/cinema_text_muted"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="26 seasons" />

        <TextView
            android:id="@+id/tv_tv_show_certification"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_cert_badge"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:textColor="@color/cinema_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="16"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/profile_integration_tmdb"
            android:src="@drawable/ic_tmdb_attr"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_detail_rating_chip"
            android:fontFamily="@font/outfit"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/cinema_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="8.4"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tv_show_meta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta_facts">

        <TextView
            android:id="@+id/tv_tv_show_genres"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="COMEDY · ANIMATION" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="5dp"
        android:lineSpacingMultiplier="1.08"
        android:maxLines="3"
        android:textColor="@color/cinema_text_soft"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta_row"
        tools:text="Overview" />

    <TextView
        android:id="@+id/tv_tv_show_overview_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.04"
        android:minHeight="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/detail_overview_more"
        android:textColor="@color/cinema_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_synopsis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_tv_show_overview,tv_tv_show_overview_more" />

    <TextView
        android:id="@+id/btn_tv_show_watch_now"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_detail_watch_now"
        android:drawablePadding="10dp"
        android:elevation="6dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/tv_show_watch_season_episode"
        android:textAllCaps="true"
        android:textColor="@color/cinema_cta_ink"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_synopsis" />

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#80646464"
        android:progressTint="@color/cinema_text"
        app:layout_constraintEnd_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/btn_tv_show_watch_now"
        tools:progress="80" />

    <LinearLayout
        android:id="@+id/ll_tv_show_cta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_favorite"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/detail_add_to_list"
                android:padding="14dp"
                android:src="@drawable/ic_list_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.02"
                android:text="@string/detail_action_list"
                android:textColor="@color/cinema_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_tv_show_trailer_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_trailer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/tv_show_trailer"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trailer_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.02"
                android:text="@string/detail_action_trailer"
                android:textColor="@color/cinema_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_download"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/option_show_download"
                android:padding="13dp"
                android:src="@drawable/ic_player_settings_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.02"
                android:text="@string/detail_action_download"
                android:textColor="@color/cinema_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_watched"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/option_show_watched"
                android:padding="12dp"
                android:src="@drawable/ic_watched" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.02"
                android:text="@string/detail_action_watched"
                android:textColor="@color/cinema_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_tv_show_share_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_tv_show_share"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_detail_square_chip"
                android:contentDescription="@string/detail_share"
                android:padding="13dp"
                android:src="@drawable/ic_detail_share" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.02"
                android:text="@string/detail_action_share"
                android:textColor="@color/cinema_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
