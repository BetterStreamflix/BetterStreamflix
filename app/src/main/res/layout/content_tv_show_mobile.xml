<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <Space
        android:id="@+id/space_tv_show_hero"
        android:layout_width="0dp"
        android:layout_height="280dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_tv_show_share"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:contentDescription="@string/detail_share"
        android:src="@drawable/ic_detail_share"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_tv_show_logo"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_tv_show_hero"
        tools:src="@mipmap/ic_launcher"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="10"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space_tv_show_hero"
        tools:text="SOUTH PARK" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_tv_show_logo,tv_tv_show_title" />

    <LinearLayout
        android:id="@+id/ll_tv_show_cta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand">

        <TextView
            android:id="@+id/btn_tv_show_watch_now"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_detail_watch_now"
            android:drawablePadding="8dp"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/tv_show_watch_season_episode"
            android:textAllCaps="true"
            android:textColor="#121218"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_tv_show_favorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_detail_square_chip"
            android:contentDescription="@string/detail_add_to_list"
            android:padding="12dp"
            android:src="@drawable/ic_list_add" />

        <TextView
            android:id="@+id/btn_tv_show_trailer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_detail_square_chip"
            android:contentDescription="@string/tv_show_trailer"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFF" />

        <ImageView
            android:id="@+id/btn_tv_show_download"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_detail_square_chip"
            android:contentDescription="@string/option_show_download"
            android:padding="12dp"
            android:src="@drawable/ic_player_settings_download" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#80646464"
        android:progressTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="@id/ll_tv_show_cta_row"
        app:layout_constraintStart_toStartOf="@id/ll_tv_show_cta_row"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_cta_row"
        tools:progress="80" />

    <LinearLayout
        android:id="@+id/ll_tv_show_meta_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode">

        <TextView
            android:id="@+id/tv_tv_show_genres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="COMEDY" />

        <TextView
            android:id="@+id/tv_tv_show_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/manrope"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="29 SEASONS" />

        <TextView
            android:id="@+id/tv_tv_show_released"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/manrope"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="1997" />

        <TextView
            android:id="@+id/tv_tv_show_certification"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cert_badge"
            android:fontFamily="@font/manrope"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="16"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/iv_tv_show_rating_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_tv_show_rating"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_tv_show_quality"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tv_show_meta_row"
        tools:text="Overview" />

    <TextView
        android:id="@+id/tv_tv_show_overview_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:minHeight="28dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="@string/detail_overview_more"
        android:textColor="#8AFFFFFF"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_tv_show_detail_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview_more" />

</androidx.constraintlayout.widget.ConstraintLayout>
