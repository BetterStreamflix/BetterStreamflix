<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/ll_detail_trailer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Kept for ViewBinding compatibility with older single-row code paths. -->
    <LinearLayout
        android:id="@+id/ll_detail_trailer_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_detail_trailer_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/iv_detail_trailer_play"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_detail_trailer_title"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_meta"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_desc"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detail_trailer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/detail_trailer_empty"
        android:textColor="#8AFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
