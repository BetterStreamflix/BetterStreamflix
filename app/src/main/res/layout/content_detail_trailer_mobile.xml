<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="32dp">

    <!-- In-tab premium trailer stage (16:9). -->
    <FrameLayout
        android:id="@+id/fl_detail_trailer_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detail_trailer_stage"
        android:clipToOutline="true"
        android:clipToPadding="true"
        android:minHeight="200dp"
        android:visibility="gone"
        tools:visibility="visible">

        <WebView
            android:id="@+id/wv_detail_trailer"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <View
            android:id="@+id/v_detail_trailer_shimmer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_detail_trailer_shimmer"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pb_detail_trailer_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/cinema_text"
            android:visibility="gone" />

        <!-- Post-trailer CTA: big Stream now after YT ENDED. -->
        <TextView
            android:id="@+id/btn_detail_trailer_stream_now"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_featured_cta_primary"
            android:elevation="6dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:minWidth="220dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/trailer_stream_now"
            android:textColor="@color/cinema_cta_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/ll_detail_trailer_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_detail_trailer_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/trailer_in_app_error"
                android:textColor="@color/cinema_text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_detail_trailer_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_detail_trailer_chrome_btn"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/detail_trailer_retry"
                    android:textColor="@color/cinema_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_detail_trailer_open_external"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_featured_cta_primary"
                    android:fontFamily="@font/manrope"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/trailer_open_in_youtube"
                    android:textColor="@color/cinema_cta_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_detail_trailer_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_detail_trailer_now_playing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit"
            android:maxLines="2"
            android:textColor="@color/cinema_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Official Trailer" />

        <ImageButton
            android:id="@+id/btn_detail_trailer_mute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_detail_trailer_icon_btn"
            android:contentDescription="@string/detail_trailer_mute"
            android:padding="9dp"
            android:src="@drawable/ic_trailer_muted"
            android:tint="@color/cinema_text_soft"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/btn_detail_trailer_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_detail_trailer_icon_btn"
            android:contentDescription="@string/detail_trailer_fullscreen"
            android:padding="9dp"
            android:src="@drawable/ic_trailer_fullscreen"
            android:tint="@color/cinema_text_soft"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detail_trailer_more_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.08"
        android:text="@string/detail_trailer_more_label"
        android:textAllCaps="true"
        android:textColor="@color/cinema_text_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_detail_trailer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <!-- Kept for ViewBinding compatibility with older single-row code paths. -->
    <LinearLayout
        android:id="@+id/ll_detail_trailer_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_detail_trailer_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/iv_detail_trailer_play"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tv_detail_trailer_title"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_meta"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_desc"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detail_trailer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:minHeight="160dp"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="48dp"
        android:text="@string/detail_trailer_empty"
        android:textColor="@color/cinema_text_faint"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
