<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- In-tab modern trailer player. -->
    <FrameLayout
        android:id="@+id/fl_detail_trailer_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:minHeight="200dp"
        android:visibility="gone"
        tools:visibility="visible">

        <WebView
            android:id="@+id/wv_detail_trailer"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <ProgressBar
            android:id="@+id/pb_detail_trailer_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_detail_trailer_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_detail_trailer_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/trailer_in_app_error"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_detail_trailer_open_external"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_featured_cta_primary"
                android:fontFamily="@font/manrope"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/trailer_open_in_youtube"
                android:textColor="#121218"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_detail_trailer_now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:maxLines="2"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Official Trailer"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_detail_trailer_more_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.06"
        android:text="@string/detail_trailer_more_label"
        android:textAllCaps="true"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ll_detail_trailer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- Kept for ViewBinding compatibility with older single-row code paths. -->
    <LinearLayout
        android:id="@+id/ll_detail_trailer_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_detail_trailer_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/iv_detail_trailer_play"
            android:layout_width="0dp"
            android:layout_height="0dp"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_detail_trailer_title"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_meta"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/tv_detail_trailer_desc"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_detail_trailer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/detail_trailer_empty"
        android:textColor="#8AFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
