<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere"
    tools:context=".fragments.season.SeasonMobileFragment">

    <TextView
        android:id="@+id/tv_season_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="72dp"
        android:text="@string/exp_season_eyebrow"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_season_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="22dp"
        android:textAppearance="@style/TextAppearance.Lumina.Hero"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_season_eyebrow"
        app:layout_constraintTop_toBottomOf="@id/tv_season_eyebrow"
        tools:text="Season 1" />

    <TextView
        android:id="@+id/tv_season_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/exp_season_tagline"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_season_title"
        app:layout_constraintStart_toStartOf="@id/tv_season_title"
        app:layout_constraintTop_toBottomOf="@id/tv_season_title" />

    <View
        android:id="@+id/v_season_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintStart_toStartOf="@id/tv_season_title"
        app:layout_constraintTop_toBottomOf="@id/tv_season_tagline" />

    <View
        android:id="@+id/v_season_header_fade"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_exp_header_fade"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_season_rule" />

    <Spinner
        android:id="@+id/sp_season_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_exp_spinner"
        android:contentDescription="@string/season_switch_content_description"
        android:minWidth="160dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_season_title"
        app:layout_constraintTop_toBottomOf="@id/v_season_header_fade" />

    <TextView
        android:id="@+id/btn_season_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/season_download"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintBottom_toBottomOf="@id/sp_season_picker"
        app:layout_constraintStart_toEndOf="@id/sp_season_picker"
        app:layout_constraintTop_toTopOf="@id/sp_season_picker" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_episodes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="110dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sp_season_picker"
        tools:listitem="@layout/item_episode_mobile_exp" />

        <TextView
        android:id="@+id/tv_season_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_exp_glass_card"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorPrimary"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/season_empty"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_season_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sp_season_picker"
        app:layout_constraintVertical_chainStyle="packed"
        tools:visibility="visible"
        app:layout_constraintWidth_max="360dp"/>

    
    <View
        android:id="@+id/v_season_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_season_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_season_empty"
        app:layout_constraintStart_toStartOf="@id/tv_season_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_season_empty"
        tools:visibility="visible" />

<TextView
        android:id="@+id/btn_season_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_exp_button_primary"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="@string/exp_empty_back"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.Lumina.Caption"
        android:textColor="?attr/colorOnPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_season_empty"
        app:layout_constraintStart_toStartOf="@id/tv_season_empty"
        app:layout_constraintTop_toBottomOf="@id/v_season_empty_rule"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_detail_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_exp_icon_chip"
        android:contentDescription="@string/exp_back"
        android:elevation="10dp"
        android:padding="11dp"
        android:src="@drawable/ic_player_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <include
        android:id="@+id/is_loading"
        layout="@layout/layout_is_loading_mobile_exp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
