<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/cinema_room_preview_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cinema_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/v_cinema_room_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_indicator" />

            <TextView
                android:id="@+id/tv_cinema_room_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/manrope"
                android:text="@string/cinema_room_brand_label"
                android:textColor="@color/cinema_text_soft"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_meta_pill"
            android:clipToOutline="true">

            <View
                android:id="@+id/v_cinema_room_poster_a"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="18dp"
                android:background="@drawable/bg_cinema_glass_card" />

            <View
                android:id="@+id/v_cinema_room_poster_b"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_cinema_glass_card" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cinema_room_scene_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/cinema_room_preview_scene_title"
                    android:textColor="@color/cinema_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cinema_room_scene_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope"
                    android:text="@string/cinema_room_preview_scene_sub"
                    android:textColor="@color/cinema_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_cinema_room_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/cinema_text_muted"
            android:textSize="12sp"
            tools:text="Enabled — Ambient starts after 90s idle on TV Home" />
    </LinearLayout>

</FrameLayout>
