<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="50dp"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:layout_constraintDimensionRatio="2:3"
        tools:layout_height="0dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="70dp"
        android:textColor="@color/cinema_text"
        android:textSize="50sp"
        android:fontFamily="@font/syne"
        android:maxWidth="720dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="70dp"
        tools:text="Title" />

    <ImageView
        android:id="@+id/iv_tv_show_logo"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="70dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="720dp"
        android:scaleType="fitStart"
        android:visibility="invisible"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="70dp"
        tools:src="@mipmap/ic_launcher"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_brand_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_tv_show_logo,tv_tv_show_title" />

    <ImageView
        android:id="@+id/iv_tv_show_rating_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="40dp"
        android:src="@drawable/ic_star"
        android:tint="#C0C0C0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_tv_show_rating"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="@id/tv_tv_show_rating"
        app:layout_goneMarginStart="70dp"
        tools:ignore="ContentDescription,UseAppTint"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:textColor="@color/cinema_text"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_rating_icon"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="#.#"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_certification"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_cert_badge"
        android:gravity="center"
        android:textColor="@color/cinema_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_rating"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="16"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp"
        android:textAllCaps="true"
        android:textColor="@color/cinema_text"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_certification"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        app:layout_goneMarginStart="25dp"
        tools:text="HD"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_released"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp"
        android:textColor="@color/cinema_text"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_quality"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="yyyy"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="15dp"
        android:textColor="@color/cinema_text"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_released"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="# h # min"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_tv_show_rating,tv_tv_show_certification,tv_tv_show_quality,tv_tv_show_released,tv_tv_show_runtime" />

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="70dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textColor="@color/cinema_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        app:layout_goneMarginStart="70dp"
        tools:text="Genres" />

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="70dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:maxLines="10"
        android:textColor="@color/cinema_text_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        app:layout_goneMarginStart="70dp"
        tools:text="Overview" />

    <TextView
        android:id="@+id/btn_tv_show_watch_now"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_share"
        android:nextFocusRight="@id/btn_tv_show_trailer"
        android:text="@string/tv_show_watch_season_episode"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        app:layout_goneMarginStart="70dp" />

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#CC646464"
        android:progressTint="@color/cinema_text"
        app:layout_constraintEnd_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/btn_tv_show_watch_now"
        tools:progress="80" />

    <TextView
        android:id="@+id/btn_tv_show_trailer"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_share"
        android:nextFocusLeft="@id/btn_tv_show_watch_now"
        android:nextFocusRight="@id/btn_tv_show_download"
        android:text="@string/tv_show_trailer"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_download"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_favorite"
        android:nextFocusLeft="@id/btn_tv_show_trailer"
        android:nextFocusRight="@id/btn_tv_show_watched"
        android:text="@string/option_show_download"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_trailer"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_watched"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_favorite"
        android:nextFocusLeft="@id/btn_tv_show_download"
        android:text="@string/option_show_watched"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_download"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_share"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusRight="@id/btn_tv_show_favorite"
        android:nextFocusUp="@id/btn_tv_show_watch_now"
        android:text="@string/detail_share"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode"
        app:layout_goneMarginStart="70dp" />

    <ImageView
        android:id="@+id/btn_tv_show_favorite"
        style="@style/AppTheme.Widget.Tv.Button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:contentDescription="@string/option_show_favorite"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_tv_show_share"
        android:nextFocusUp="@id/btn_tv_show_download"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:src="@drawable/ic_favorite_disable"
        android:tint="@drawable/color_button_text"
        app:layout_constraintBottom_toBottomOf="@id/btn_tv_show_share"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_share"
        app:layout_constraintTop_toTopOf="@id/btn_tv_show_share"
        tools:ignore="UseAppTint" />

</androidx.constraintlayout.widget.ConstraintLayout>
