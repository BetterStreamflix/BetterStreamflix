<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/iv_tv_show_poster"
        android:layout_width="@dimen/detail_tv_poster_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="40dp"
        android:adjustViewBounds="true"
        android:alpha="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription"
        tools:layout_constraintDimensionRatio="2:3"
        tools:layout_height="0dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="64dp"
        android:fontFamily="@font/syne"
        android:maxWidth="760dp"
        android:shadowColor="#E6000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="14"
        android:textColor="@color/cinema_text"
        android:textSize="46sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="64dp"
        tools:text="Title" />

    <ImageView
        android:id="@+id/iv_tv_show_logo"
        android:layout_width="0dp"
        android:layout_height="@dimen/detail_tv_logo_height"
        android:layout_marginStart="36dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="64dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="760dp"
        android:padding="2dp"
        android:scaleType="fitStart"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="64dp"
        tools:src="@mipmap/ic_launcher"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_tv_show_brand_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_tv_show_logo,tv_tv_show_title" />

    <ImageView
        android:id="@+id/iv_tv_show_rating_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="36dp"
        android:src="@drawable/ic_star"
        android:tint="@color/cinema_text_muted"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_tv_show_rating"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toTopOf="@id/tv_tv_show_rating"
        app:layout_goneMarginStart="64dp"
        tools:ignore="ContentDescription,UseAppTint"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/outfit"
        android:textColor="@color/cinema_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_rating_icon"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="8.4"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_certification"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_cert_badge"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:textColor="@color/cinema_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_rating"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="16"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/outfit"
        android:textAllCaps="true"
        android:textColor="@color/cinema_text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_certification"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        app:layout_goneMarginStart="16dp"
        tools:text="HD"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_released"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/cinema_text_muted"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_quality"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="1997"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_tv_show_runtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/cinema_text_muted"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/barrier1"
        app:layout_constraintStart_toEndOf="@id/tv_tv_show_released"
        app:layout_constraintTop_toBottomOf="@id/barrier_tv_show_brand_tv"
        tools:text="26 seasons"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_tv_show_rating,tv_tv_show_certification,tv_tv_show_quality,tv_tv_show_released,tv_tv_show_runtime" />

    <TextView
        android:id="@+id/tv_tv_show_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="64dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/outfit"
        android:textColor="@color/cinema_text_soft"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/barrier1"
        app:layout_goneMarginStart="64dp"
        tools:text="Comedy · Animation" />

    <TextView
        android:id="@+id/tv_tv_show_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="64dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="3dp"
        android:maxLines="5"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="8"
        android:textColor="@color/cinema_text_soft"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_genres"
        app:layout_goneMarginStart="64dp"
        tools:text="Overview" />

    <TextView
        android:id="@+id/btn_tv_show_watch_now"
        style="@style/AppTheme.Widget.Tv.Button.DetailPrimary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="22dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_watched"
        android:nextFocusRight="@id/btn_tv_show_favorite"
        android:text="@string/tv_show_watch_season_episode"
        app:layout_constraintStart_toEndOf="@id/iv_tv_show_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview"
        app:layout_goneMarginStart="64dp" />

    <ProgressBar
        android:id="@+id/pb_tv_show_progress_episode"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="#80646464"
        android:progressTint="@color/cinema_text"
        app:layout_constraintEnd_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/btn_tv_show_watch_now"
        tools:progress="80" />

    <TextView
        android:id="@+id/btn_tv_show_favorite"
        style="@style/AppTheme.Widget.Tv.Button.DetailSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="22dp"
        android:contentDescription="@string/detail_add_to_list"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_share"
        android:nextFocusLeft="@id/btn_tv_show_watch_now"
        android:nextFocusRight="@id/btn_tv_show_trailer"
        android:text="@string/detail_action_list"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_trailer"
        style="@style/AppTheme.Widget.Tv.Button.DetailSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="22dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_share"
        android:nextFocusLeft="@id/btn_tv_show_favorite"
        android:nextFocusRight="@id/btn_tv_show_download"
        android:text="@string/tv_show_trailer"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_favorite"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_download"
        style="@style/AppTheme.Widget.Tv.Button.DetailSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="22dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_tv_show_share"
        android:nextFocusLeft="@id/btn_tv_show_trailer"
        android:text="@string/option_show_download"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_trailer"
        app:layout_constraintTop_toBottomOf="@id/tv_tv_show_overview" />

    <TextView
        android:id="@+id/btn_tv_show_watched"
        style="@style/AppTheme.Widget.Tv.Button.DetailSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusRight="@id/btn_tv_show_share"
        android:nextFocusUp="@id/btn_tv_show_watch_now"
        android:text="@string/option_show_watched"
        app:layout_constraintStart_toStartOf="@id/btn_tv_show_watch_now"
        app:layout_constraintTop_toBottomOf="@id/pb_tv_show_progress_episode"
        app:layout_goneMarginStart="64dp" />

    <TextView
        android:id="@+id/btn_tv_show_share"
        style="@style/AppTheme.Widget.Tv.Button.DetailSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_tv_show_watched"
        android:nextFocusUp="@id/btn_tv_show_favorite"
        android:text="@string/detail_share"
        app:layout_constraintBottom_toBottomOf="@id/btn_tv_show_watched"
        app:layout_constraintStart_toEndOf="@id/btn_tv_show_watched"
        app:layout_constraintTop_toTopOf="@id/btn_tv_show_watched" />

</androidx.constraintlayout.widget.ConstraintLayout>
