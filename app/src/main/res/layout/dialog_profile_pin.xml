<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_profile_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <com.dskja.betterstreamflix.profiles.ProfileAvatarView
        android:id="@+id/pav_profile_pin_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp" />

    <TextView
        android:id="@+id/tv_profile_pin_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textAppearance="@style/TextAppearance.Lumina.Title"
        android:gravity="center"
        android:textColor="@color/profile_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Enter PIN for Alex" />

    <View
        android:id="@+id/v_profile_pin_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_exp_accent_rule" />

    <EditText
        android:id="@+id/et_profile_pin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_profile_field"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:gravity="center"
        android:hint="@string/profile_pin_title"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.3"
        android:maxLength="8"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/profile_text_primary"
        android:textColorHint="@color/profile_text_tertiary"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_profile_pin_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@android:string/cancel"
            android:textColor="@color/profile_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_profile_pin_ok"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_profile_btn_primary"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@android:string/ok"
            android:textColor="@color/profile_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
