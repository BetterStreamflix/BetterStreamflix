<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed Cinema Room Ambient overlay: soft poster cinemagraphs + Continue strip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ambient_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:focusable="false"
    android:visibility="gone"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/iv_ambient_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_ambient_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription" />

    <!-- Ambient-light hint target — palette radial glow when Cinema Room allows. -->
    <View
        android:id="@+id/v_ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/v_ambient_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_end_card_scrim"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/ll_cinema_room_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_cinema_room_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/syne"
            android:letterSpacing="0.06"
            android:contentDescription="@string/cinema_room_brand_label"
            android:text="@string/cinema_room_brand_label"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_cinema_room_wake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.04"
            android:text="@string/cinema_room_wake_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_ambient_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tv_ambient_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.08"
            android:text="@string/tv_ambient_continue_label"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_ambient_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/syne"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            tools:text="Severance" />

        <!-- Height set at runtime via LeanbackDensityPolicy.ambientStripHeightDp(). -->
        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/hgv_ambient_continue"
            android:layout_width="match_parent"
            android:layout_height="188dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:focusOutEnd="true"
            app:focusOutFront="true"
            app:numberOfRows="1"
            tools:itemCount="4"
            tools:listitem="@layout/item_episode_continue_watching_tv" />
    </LinearLayout>

</FrameLayout>
