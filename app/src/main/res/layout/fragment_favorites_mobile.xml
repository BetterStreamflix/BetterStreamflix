<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Title stays centered; Edit/Cancel/Remove overlay without shifting it. -->
    <TextView
        android:id="@+id/tv_favorites_title"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:text="@string/main_menu_favorites"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_favorites_cancel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:elevation="2dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="@string/favorites_cancel"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_favorites_edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:elevation="2dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/favorites_edit"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_favorites_remove"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:elevation="2dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/favorites_remove"
        android:textColor="#4DFFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Legacy IDs kept so FavoritesMobileFragment still compiles until wired. -->
    <TextView
        android:id="@+id/tv_favorites_eyebrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_favorites_rule"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_title" />

    <TextView
        android:id="@+id/tv_favorites_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:drawableTop="@drawable/ic_list_add"
        android:drawablePadding="16dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/favorites_empty"
        android:textColor="#8AFFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
