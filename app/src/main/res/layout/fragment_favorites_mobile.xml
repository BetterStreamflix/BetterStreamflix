<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/app_background_color">

    <!-- Toolbar row: Cancel | title | Sort/Edit/Remove — no overlapping full-bleed title steal. -->
    <TextView
        android:id="@+id/btn_favorites_cancel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="@string/favorites_cancel"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_favorites_title"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/main_menu_favorites"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/favorites_actions_end"
        app:layout_constraintStart_toEndOf="@id/btn_favorites_cancel"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/favorites_actions_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="btn_favorites_sort,btn_favorites_edit,btn_favorites_remove" />

    <ImageButton
        android:id="@+id/btn_favorites_sort"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/favorites_sort_title"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_sort"
        android:tint="?android:attr/textColorPrimary"
        app:layout_constraintEnd_toStartOf="@id/btn_favorites_edit"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_favorites_edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:text="@string/favorites_edit"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_favorites_remove"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/favorites_remove"
        android:textColor="#4DFFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <!-- Legacy IDs kept so FavoritesMobileFragment still compiles until wired. -->
    <TextView
        android:id="@+id/tv_favorites_eyebrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_favorites_rule"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_title" />

    <TextView
        android:id="@+id/tv_favorites_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:drawableTop="@drawable/ic_list_add"
        android:drawablePadding="16dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/favorites_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v_favorites_empty_rule"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:visibility="visible" />

    <View
        android:id="@+id/v_favorites_empty_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_favorites_empty_cta"
        app:layout_constraintEnd_toEndOf="@id/tv_favorites_empty"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_empty"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_empty"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_favorites_empty_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/manrope"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/exp_empty_browse_catalog"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/tv_favorites_empty"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_empty"
        app:layout_constraintTop_toBottomOf="@id/v_favorites_empty_rule"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
