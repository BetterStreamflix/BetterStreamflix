<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sv_offline_studio_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="16dp"
    android:scrollbars="none"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/ll_offline_studio_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/tv_offline_studio_controls_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp"
            android:text="@string/offline_studio_controls_intro"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/card_offline_studio_smart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_smart_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- CheckBox on TV-safe path: MaterialSwitch NPEs under Leanback themes. -->
            <CheckBox
                android:id="@+id/switch_offline_studio_smart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#E6FFFFFF"
                android:contentDescription="@string/offline_studio_smart_toggle"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="48dp"
                android:text="@string/offline_studio_smart_toggle"
                android:textColor="#E6FFFFFF"
                android:textOff="@string/offline_studio_smart_toggle"
                android:textOn="@string/offline_studio_smart_toggle"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_offline_studio_quota_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                tools:text="Quota load · 4 across 2 series · max 3 each" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope"
                    android:text="@string/settings_download_smart_lookahead"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_offline_studio_lookahead_minus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_lookahead_minus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_offline_studio_lookahead_value"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="3" />

                <TextView
                    android:id="@+id/btn_offline_studio_lookahead_plus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_lookahead_plus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope"
                    android:text="@string/offline_studio_series_quota"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_offline_studio_quota_minus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_quota_minus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_offline_studio_quota_value"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="3" />

                <TextView
                    android:id="@+id/btn_offline_studio_quota_plus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_quota_plus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/switch_offline_studio_auto_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#E6FFFFFF"
                android:contentDescription="@string/offline_studio_auto_delete"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="48dp"
                android:text="@string/offline_studio_auto_delete"
                android:textColor="#E6FFFFFF"
                android:textOff="@string/offline_studio_auto_delete"
                android:textOn="@string/offline_studio_auto_delete"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_offline_studio_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_storage_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_studio_storage_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="Soft limit 20 GB · up to 2 parallel" />

            <CheckBox
                android:id="@+id/switch_offline_studio_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#E6FFFFFF"
                android:contentDescription="@string/offline_studio_wifi_toggle"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minHeight="48dp"
                android:text="@string/offline_studio_wifi_toggle"
                android:textColor="#E6FFFFFF"
                android:textOff="@string/offline_studio_wifi_toggle"
                android:textOn="@string/offline_studio_wifi_toggle"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_offline_studio_wifi_window_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/manrope"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                tools:text="Wi‑Fi window off" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope"
                    android:text="@string/settings_download_soft_limit"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_offline_studio_soft_minus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_soft_minus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_offline_studio_soft_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="120dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="20" />

                <TextView
                    android:id="@+id/btn_offline_studio_soft_plus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_soft_plus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope"
                    android:text="@string/offline_studio_max_concurrent"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_offline_studio_concurrent_minus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_concurrent_minus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_offline_studio_concurrent_value"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="2" />

                <TextView
                    android:id="@+id/btn_offline_studio_concurrent_plus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_download_filter_chip"
                    android:contentDescription="@string/offline_studio_stepper_concurrent_plus"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_offline_studio_packs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_cinema_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/offline_studio_packs_title"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_offline_studio_packs_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="2 season packs ready to share" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="start"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_offline_studio_pack_share"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minHeight="44dp"
                    android:text="@string/offline_studio_pack_share"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_offline_studio_pack_import"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/offline_studio_pack_import"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_offline_studio_open_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/offline_studio_open_settings"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
