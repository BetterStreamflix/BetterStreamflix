<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_exp_bottom_sheet"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_download_options_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Lumina.Brand"
            android:textSize="22sp"
            tools:text="Beispieltext" />

        <View
            android:id="@+id/v_download_options_rule"
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_exp_accent_rule" />

        <TextView
            android:id="@+id/tv_download_options_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textAppearance="@style/TextAppearance.Lumina.Body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_download_options_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.1"
            android:text="@string/download_options_server"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/sp_download_server"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_exp_spinner"
            android:paddingStart="10dp"
            android:paddingEnd="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="@string/download_options_quality"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/sp_download_quality"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_exp_spinner"
            android:paddingStart="10dp"
            android:paddingEnd="28dp" />

        <ProgressBar
            android:id="@+id/pb_download_options_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_download_options_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/download_options_wifi_hint"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
