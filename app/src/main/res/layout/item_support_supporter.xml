<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_support_card_focusable"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <ImageView
        android:layout_width="@dimen/support_icon_size"
        android:layout_height="@dimen/support_icon_size"
        android:contentDescription="@string/support_supporters_title"
        android:src="@drawable/ic_support_heart"
        android:tint="@color/support_accent"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_support_supporter_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Lumina.Body"
            android:textColor="@color/support_text_primary"
            android:textSize="@dimen/support_text_card_title"
            android:textStyle="bold"
            tools:text="Zem936" />

        <TextView
            android:id="@+id/tv_support_supporter_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Lumina.Caption"
            android:textColor="@color/support_text_secondary"
            android:textSize="@dimen/support_text_secondary"
            tools:text="First Buy Me a Coffee supporter" />
    </LinearLayout>
</LinearLayout>
