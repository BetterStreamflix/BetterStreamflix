<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sh_load_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="?attr/colorSurfaceContainerHigh"
        app:shimmer_highlight_color="?attr/colorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="110dp"
                android:layout_height="165dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_exp_skeleton" />

            <View
                android:layout_width="110dp"
                android:layout_height="165dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_exp_skeleton" />

            <View
                android:layout_width="110dp"
                android:layout_height="165dp"
                android:background="@drawable/bg_exp_skeleton" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Required by ItemLoadingBinding (shared with item_loading.xml). -->
    <View
        android:id="@+id/v_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Kept for AppAdapter.LoadingViewHolder / non-exp fallbacks; hidden under Lumina -->
    <ProgressBar
        android:id="@+id/pb_load_more_is_loading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/sh_load_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/sh_load_more" />

</androidx.constraintlayout.widget.ConstraintLayout>
