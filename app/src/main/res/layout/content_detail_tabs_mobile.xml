<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hsv_detail_tabs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_detail_tabs_surface"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingTop="4dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ll_detail_tabs"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tab_detail_episodes"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/detail_tab_episodes"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text_faint"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:background="@drawable/bg_detail_tab_underline"
            tools:textColor="@color/cinema_text" />

        <TextView
            android:id="@+id/tab_detail_similar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/detail_tab_similar"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text_faint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_detail_trailer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/detail_tab_trailer"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text_faint"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_detail_about"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/detail_tab_about"
            android:textAllCaps="true"
            android:textColor="@color/cinema_text_faint"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</HorizontalScrollView>
