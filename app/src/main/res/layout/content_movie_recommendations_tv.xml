<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_movie_recommendations_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:text="@string/movie_you_may_also_like"
        android:textColor="@color/cinema_text"
        android:textSize="22sp"
        android:fontFamily="@font/syne"
        android:textStyle="bold"
        android:accessibilityHeading="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_movie_recommendations_rule"
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_exp_accent_rule"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/tv_movie_recommendations_label"
        app:layout_constraintTop_toBottomOf="@id/tv_movie_recommendations_label"
        tools:visibility="visible" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/hgv_movie_recommendations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="70dp"
        android:paddingTop="26dp"
        android:paddingEnd="70dp"
        android:paddingBottom="10dp"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_movie_recommendations_rule"
        tools:listitem="@layout/item_movie_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>
