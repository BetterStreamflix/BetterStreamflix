        <item name="colorControlHighlight">@color/exp_slate_primary_container</item>
    </style>

    <style name="AppTheme.Mobile.Experimental.PureBlack" parent="AppTheme.Mobile.Experimental">
        <item name="colorSurface">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="app_background_color">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>

    <style name="AppTheme.Mobile.Experimental.Ember.PureBlack" parent="AppTheme.Mobile.Experimental.Ember">
        <item name="colorSurface">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="app_background_color">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>

    <style name="AppTheme.Mobile.Experimental.Aurora.PureBlack" parent="AppTheme.Mobile.Experimental.Aurora">
        <item name="colorSurface">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="app_background_color">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>

    <style name="AppTheme.Mobile.Experimental.Slate.PureBlack" parent="AppTheme.Mobile.Experimental.Slate">
        <item name="colorSurface">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="app_background_color">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>

    <style name="PreferenceThemeOverlay.Exp" parent="PreferenceThemeOverlay">
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="android:colorBackground">@color/m3_surface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Nocturne.Title</item>
        <item name="textAppearanceListItemSecondary">@style/TextAppearance.Nocturne.Caption</item>
    </style>

    <style name="Theme.Exp.Dialog.Alert" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Nocturne.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Nocturne.Body</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="ThemeOverlay.Exp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/m3_surface_container_high</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Nocturne.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Nocturne.Body</item>
    </style>

    <!-- Legacy 10-skin style ids keep resolving; they all parent Nocturne accents. -->
    <style name="AppTheme.Mobile.NeroAmoledOled" parent="AppTheme.Mobile.Experimental.PureBlack" />
    <style name="AppTheme.Mobile.SunsetCinema" parent="AppTheme.Mobile.Experimental" />
    <style name="AppTheme.Mobile.SteelBlue" parent="AppTheme.Mobile.Experimental.Slate" />
    <style name="AppTheme.Mobile.ForestNight" parent="AppTheme.Mobile.Experimental.Aurora" />
    <style name="AppTheme.Mobile.CrimsonNoir" parent="AppTheme.Mobile.Experimental" />
    <style name="AppTheme.Mobile.MidnightViolet" parent="AppTheme.Mobile.Experimental.Ember" />
    <style name="AppTheme.Mobile.NordFrost" parent="AppTheme.Mobile.Experimental.Slate" />
    <style name="AppTheme.Mobile.EmeraldLuxe" parent="AppTheme.Mobile.Experimental.Aurora" />
    <style name="AppTheme.Mobile.RetroNeon" parent="AppTheme.Mobile.Experimental.Ember" />

    <!-- Leanback TV shell — same Nocturne canvas and type as mobile. -->
    <style name="AppTheme.Tv" parent="Theme.Leanback">
        <item name="app_background_color">@color/m3_surface</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlayLeanback</item>
        <item name="alertDialogTheme">@style/Theme.Exp.Dialog.Alert</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="colorControlNormal">@color/m3_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="defaultBrandColor">@color/m3_surface</item>
        <item name="defaultSearchColor">@color/m3_surface</item>
        <item name="defaultSearchBrightColor">@color/m3_surface_container</item>
        <item name="defaultSearchIconColor">@color/m3_on_surface</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_exp</item>
