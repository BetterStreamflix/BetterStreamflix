<resources>

    <!--
      Nocturne is the only mobile language. Manifest activities resolve
      AppTheme.Mobile; setTheme() applies the matching accent overlay.
      Parenting Experimental keeps Material color attrs for TextAppearance.Nocturne
      (Sentry BETTERSTREAMFLIX-14 / -15).
    -->
    <style name="AppTheme.Mobile" parent="AppTheme.Mobile.Experimental" />

    <style name="BottomNavLabelStyle" parent="Widget.Design.BottomNavigationView">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="BottomNavLabelStyleExp" parent="Widget.Design.BottomNavigationView">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/syne_family</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nocturne M3 dark shell. DynamicColors may tint on Android 12+ when opted in. -->
    <style name="AppTheme.Mobile.Experimental" parent="Theme.Material3.Dark.NoActionBar">
        <item name="app_background_color">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackground">?attr/colorSurface</item>

        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>

        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlHighlight">?attr/colorPrimaryContainer</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Exp</item>
        <item name="alertDialogTheme">@style/Theme.Exp.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Exp.MaterialAlertDialog</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Nocturne.Hero</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Nocturne.Brand</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Nocturne.Title</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Nocturne.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Nocturne.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Nocturne.Caption</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Nocturne.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Nocturne.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Nocturne.Caption</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Nocturne.Caption</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Nocturne.Eyebrow</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Nocturne.NavLabel</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_home_gradient_exp</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_exp</item>
    </style>

    <!-- Nocturne accent: Violet (style id kept for themeRes mapping) -->
    <style name="AppTheme.Mobile.Experimental.Ember" parent="AppTheme.Mobile.Experimental">
        <item name="colorPrimary">@color/exp_ember_primary</item>
        <item name="colorOnPrimary">@color/exp_ember_on_primary</item>
        <item name="colorPrimaryContainer">@color/exp_ember_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/exp_ember_on_primary_container</item>
        <item name="colorAccent">@color/exp_ember_primary</item>
        <item name="colorControlActivated">@color/exp_ember_primary</item>
        <item name="colorControlHighlight">@color/exp_ember_primary_container</item>
    </style>

    <!-- Nocturne accent: Moss -->
    <style name="AppTheme.Mobile.Experimental.Aurora" parent="AppTheme.Mobile.Experimental">
        <item name="colorPrimary">@color/exp_aurora_primary</item>
        <item name="colorOnPrimary">@color/exp_aurora_on_primary</item>
        <item name="colorPrimaryContainer">@color/exp_aurora_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/exp_aurora_on_primary_container</item>
        <item name="colorAccent">@color/exp_aurora_primary</item>
        <item name="colorControlActivated">@color/exp_aurora_primary</item>
        <item name="colorControlHighlight">@color/exp_aurora_primary_container</item>
    </style>

    <!-- Nocturne accent: Ink -->
    <style name="AppTheme.Mobile.Experimental.Slate" parent="AppTheme.Mobile.Experimental">
        <item name="colorPrimary">@color/exp_slate_primary</item>
        <item name="colorOnPrimary">@color/exp_slate_on_primary</item>
