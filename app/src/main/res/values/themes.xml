<resources>

    <!--
      Classic mobile shell stays on AppCompat, but shared Lumina layouts
      (profile chip, support dialogs, about) resolve Material color attrs.
      Without these, TextAppearance.CinemaInk.* / ?attr/colorOnSurface inflate
      crashes at startup (Sentry BETTERSTREAMFLIX-14 / -15).
    -->
    <style name="AppTheme.Mobile" parent="Theme.AppCompat">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="app_background_color">#181818</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="selectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="selectableItemBackgroundBorderless">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="colorControlNormal">@color/m3_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_default</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_movie_banner_gradient_default</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_tv_show_banner_gradient_default</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_default</item>
        <item name="tvFocusStrokeColor">@color/tv_focus_stroke</item>
        <item name="tvFocusStrokeWidth">@dimen/tv_focus_stroke_width</item>
    </style>

    <style name="BottomNavLabelStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Dark (Cinema-Ink) — the single locked look for mobile. -->
    <style name="AppTheme.Mobile.CinemaInk" parent="AppTheme.Mobile">
        <item name="app_background_color">@color/cinema_ink</item>
        <item name="android:windowBackground">@drawable/bg_splash_screen_cinema_ink</item>
        <item name="android:colorBackground">@color/cinema_ink</item>
        <item name="colorSurface">@color/cinema_surface</item>
        <item name="colorSurfaceVariant">@color/cinema_elevated</item>
        <item name="colorAccent">@color/cinema_text</item>
        <item name="android:textColorPrimary">@color/cinema_text</item>
        <item name="android:textColorSecondary">@color/cinema_text_muted</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_cinema_ink</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_movie_banner_gradient_cinema_ink</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_tv_show_banner_gradient_cinema_ink</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_cinema_ink</item>
    </style>

    <!-- Tema di Default per TV -->
    <!--
      Leanback does not define AppCompat ripples or M3 surface-container attrs.
      Shared layouts (profile picker, downloads, support) need these or
      inflate crashes on TV (Sentry BETTERSTREAMFLIX-1N).
    -->
    <style name="AppTheme.Tv" parent="Theme.Leanback">
        <item name="app_background_color">#181818</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlayLeanbackSafe</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/Theme.AppCompat.Dialog.Alert</item>
        <item name="dialogTheme">@style/Theme.AppCompat.Dialog</item>
        <!-- Cast MediaRouteChooserDialog requires an AppCompat theme (BETTERSTREAMFLIX-26). -->
        <item name="mediaRouteTheme">@style/Theme.AppCompat</item>
        <!-- BETTERSTREAMFLIX-27: SwitchCompat needs AppCompat switchStyle under Leanback. -->
        <item name="switchStyle">@style/Widget.BetterStreamflix.Switch.LeanbackSafe</item>
        <!-- Framework ripples — available without AppCompat parent. -->
        <item name="selectableItemBackground">?android:attr/selectableItemBackground</item>
        <item name="selectableItemBackgroundBorderless">?android:attr/selectableItemBackgroundBorderless</item>
        <!-- Material color attrs for shared layouts (profile chip, support). -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="colorAccent">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>
        <item name="colorControlNormal">#BDBDBD</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_default</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_movie_banner_gradient_default</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_tv_show_banner_gradient_default</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_default</item>
        <item name="tvFocusStrokeColor">@color/tv_focus_stroke</item>
        <item name="tvFocusStrokeWidth">@dimen/tv_focus_stroke_width</item>
    </style>

    <!-- Dark (Cinema-Ink) — the single locked look for TV. -->
    <style name="AppTheme.CinemaInk" parent="AppTheme.Tv">
        <item name="app_background_color">@color/cinema_ink</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlayLeanbackSafe</item>
        <item name="alertDialogTheme">@style/Theme.AppCompat.Dialog.Alert</item>
        <item name="colorAccent">@color/cinema_text</item>
        <item name="colorControlActivated">@color/cinema_text</item>
        <item name="colorControlNormal">@color/cinema_text_muted</item>
        <item name="android:textColorPrimary">@color/cinema_text</item>
        <item name="android:textColorSecondary">@color/cinema_text_muted</item>
        <item name="android:windowBackground">@drawable/bg_splash_screen_cinema_ink</item>
        <item name="defaultBrandColor">@color/cinema_ink</item>
        <item name="defaultSearchColor">@color/cinema_ink</item>
        <item name="defaultSearchBrightColor">@color/cinema_surface</item>
        <item name="defaultSearchIconColor">@color/cinema_text</item>
        <item name="home_gradient_drawable">@drawable/bg_home_gradient_cinema_ink</item>
        <item name="movie_banner_gradient_drawable">@drawable/bg_movie_banner_gradient_cinema_ink</item>
        <item name="tv_show_banner_gradient_drawable">@drawable/bg_tv_show_banner_gradient_cinema_ink</item>
        <item name="category_swiper_gradient_drawable">@drawable/fg_category_swiper_cinema_ink</item>
    </style>

    <!-- Lumina (experimental opt-in shell) — deep-space surfaces, aurora scrims,
         per-accent focus rings. Selected via ExperimentalMobileDesign.tvThemeRes(). -->
    <!-- Stile Dialogo Nero Amoled/Oled -->
    <style name="AppTheme.SplashScreen" parent="Theme.AppCompat">
        <item name="android:windowBackground">@drawable/bg_splash_screen</item>
        <!-- Bridge Material attrs if any early inflate uses Lumina styles under splash. -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurface">@color/m3_surface</item>
    </style>

    <!--
      Accessibility high-contrast overlays — applied via theme.applyStyle on top of
      the active locked look (Cinema Ink Dark / Light / Kids). Pure black surfaces,
      near-white text, and a yellow TV focus stroke for DPAD visibility.
      Named under AppTheme.Mobile / AppTheme.Tv so the dotted parent chain resolves.
    -->
    <style name="AppTheme.Mobile.HighContrastOverlay">
        <item name="app_background_color">@color/a11y_hc_background</item>
        <item name="android:windowBackground">@color/a11y_hc_background</item>
        <item name="android:colorBackground">@color/a11y_hc_background</item>
        <item name="colorSurface">@color/a11y_hc_surface</item>
        <item name="colorSurfaceVariant">@color/a11y_hc_surface</item>
        <item name="colorOnSurface">@color/a11y_hc_text</item>
        <item name="colorOnSurfaceVariant">@color/a11y_hc_text_secondary</item>
        <item name="colorAccent">@color/a11y_hc_accent</item>
        <item name="colorControlActivated">@color/a11y_hc_accent</item>
        <item name="colorControlNormal">@color/a11y_hc_text_secondary</item>
        <item name="android:textColorPrimary">@color/a11y_hc_text</item>
        <item name="android:textColorSecondary">@color/a11y_hc_text_secondary</item>
        <item name="tvFocusStrokeColor">@color/tv_focus_stroke_high_contrast</item>
        <item name="tvFocusStrokeWidth">@dimen/tv_focus_stroke_width_hc</item>
    </style>

    <style name="AppTheme.Tv.HighContrastOverlay">
        <item name="app_background_color">@color/a11y_hc_background</item>
        <item name="android:windowBackground">@color/a11y_hc_background</item>
        <item name="android:colorBackground">@color/a11y_hc_background</item>
        <item name="colorSurface">@color/a11y_hc_surface</item>
        <item name="colorSurfaceVariant">@color/a11y_hc_surface</item>
        <item name="colorOnSurface">@color/a11y_hc_text</item>
        <item name="colorOnSurfaceVariant">@color/a11y_hc_text_secondary</item>
        <item name="colorAccent">@color/a11y_hc_accent</item>
        <item name="colorControlActivated">@color/a11y_hc_accent</item>
        <item name="colorControlNormal">@color/a11y_hc_text_secondary</item>
        <item name="android:textColorPrimary">@color/a11y_hc_text</item>
        <item name="android:textColorSecondary">@color/a11y_hc_text_secondary</item>
        <item name="defaultBrandColor">@color/a11y_hc_background</item>
        <item name="tvFocusStrokeColor">@color/tv_focus_stroke_high_contrast</item>
        <item name="tvFocusStrokeWidth">@dimen/tv_focus_stroke_width_hc</item>
    </style>

    <!--
      LD-010 / LD-027 / LD-034: Compact Leanback theme overlay.
      Remaps focus stroke via theme attr (HC overlay wins after).
      tv_shelf_poster_height / tv_ambient_continue_strip_height stay Comfort XML defaults;
      Compact heights apply at bind via LeanbackDensityPolicy (layout @dimen cannot be
      theme-item overridden without attr migration).
    -->
    <style name="AppTheme.Tv.LeanbackCompactOverlay">
        <item name="tvFocusStrokeWidth">@dimen/tv_focus_stroke_width_compact</item>
    </style>

</resources>
