<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Widget.Tv.Button" parent="AppTheme.Tv">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@drawable/color_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="AppTheme.Widget.Mobile.Button.Exp" />

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_exp_button_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Nocturne.Caption</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/exp_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textSize">13sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.Secondary" parent="AppTheme.Widget.Mobile.Button.Exp">
        <item name="android:background">@drawable/bg_exp_button_liquid_secondary</item>
        <item name="android:textColor">@color/exp_on_media</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.OnMedia" parent="AppTheme.Widget.Mobile.Button.Exp">
        <item name="android:background">@drawable/bg_exp_button_liquid_primary</item>
        <item name="android:textColor">@color/exp_on_accent</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.OnMedia.Secondary" parent="AppTheme.Widget.Mobile.Button.Exp.Secondary">
        <item name="android:background">@drawable/bg_exp_button_liquid_secondary</item>
        <item name="android:textColor">@color/exp_on_media</item>
    </style>

    <!--
      Nocturne type ladder — does not parent Lumina.
      Fraunces → display / hero
      Syne     → eyebrows, nav, brand marks
      Outfit   → titles, body, captions
      Parent AppCompat so classic themes can inflate without M3 attrs.
    -->
    <style name="TextAppearance.Nocturne.Hero" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/fraunces_family</item>
        <item name="fontFamily">@font/fraunces_family</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Nocturne.Brand" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/fraunces_family</item>
        <item name="fontFamily">@font/fraunces_family</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Nocturne.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Nocturne.Eyebrow" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/syne_family</item>
        <item name="fontFamily">@font/syne_family</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Nocturne.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.28</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Nocturne.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Nocturne.NavLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">@font/syne_family</item>
        <item name="fontFamily">@font/syne_family</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Shared Kotlin still references Lumina R.style IDs; they now inherit Nocturne. -->
    <style name="TextAppearance.Lumina.Hero" parent="TextAppearance.Nocturne.Hero" />
    <style name="TextAppearance.Lumina.Brand" parent="TextAppearance.Nocturne.Brand" />
    <style name="TextAppearance.Lumina.Title" parent="TextAppearance.Nocturne.Title" />
    <style name="TextAppearance.Lumina.Eyebrow" parent="TextAppearance.Nocturne.Eyebrow" />
    <style name="TextAppearance.Lumina.Body" parent="TextAppearance.Nocturne.Body" />
    <style name="TextAppearance.Lumina.Caption" parent="TextAppearance.Nocturne.Caption" />
    <style name="TextAppearance.Lumina.NavLabel" parent="TextAppearance.Nocturne.NavLabel" />

    <!-- Editorial shape scale: tight radii, hairline posters. -->
    <style name="ShapeAppearance.Nocturne.Poster" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.Nocturne.PosterSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">3dp</item>
    </style>

    <style name="ShapeAppearance.Nocturne.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>

    <style name="ShapeAppearance.Nocturne.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Nocturne.Episode" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.Nocturne.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Lumina.Poster" parent="ShapeAppearance.Nocturne.Poster" />
    <style name="ShapeAppearance.Lumina.PosterSmall" parent="ShapeAppearance.Nocturne.PosterSmall" />
    <style name="ShapeAppearance.Lumina.Card" parent="ShapeAppearance.Nocturne.Card" />
    <style name="ShapeAppearance.Lumina.Pill" parent="ShapeAppearance.Nocturne.Pill" />
    <style name="ShapeAppearance.Lumina.Episode" parent="ShapeAppearance.Nocturne.Episode" />
    <style name="ShapeAppearance.Lumina.Circle" parent="ShapeAppearance.Nocturne.Circle" />

    <!-- Stile per forzare il fondo nero nelle schermate di impostazione (Leanback) -->
    <!-- Usiamo direttamente android:background nella preferenceTheme per non romper il build -->
    <style name="PreferenceThemeOverlay.Leanback.Amoled" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:colorBackground">?attr/app_background_color</item>
    </style>

    <style name="SupportDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="SupportDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/support_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/support_dialog_exit</item>
    </style>

    <style name="TelegramJoinGateTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_tg_gate_fullscreen</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">1</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnSurface">@color/tg_gate_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tg_gate_text_secondary</item>
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:textColorPrimary">@color/tg_gate_text_primary</item>
        <item name="android:textColorSecondary">@color/tg_gate_text_secondary</item>
    </style>

    <style name="TelegramJoinGateActivityTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_tg_gate_fullscreen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/TelegramJoinGateAnimation</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/tg_gate_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tg_gate_text_secondary</item>
        <item name="android:fontFamily">@font/outfit_family</item>
        <item name="fontFamily">@font/outfit_family</item>
        <item name="android:textColorPrimary">@color/tg_gate_text_primary</item>
        <item name="android:textColorSecondary">@color/tg_gate_text_secondary</item>
    </style>

    <style name="TelegramJoinGateAnimation">
        <item name="android:windowEnterAnimation">@anim/tg_gate_enter</item>
        <item name="android:windowExitAnimation">@anim/tg_gate_exit</item>
    </style>

    <style name="ProfilePinKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_profile_keypad_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Nocturne.Title</item>
        <item name="android:textColor">@color/profile_text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="AboutLinkRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
